page {
  height: 100%;
  background: #f4f7fb;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.phdr {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 28rpx 16rpx;
  gap: 16rpx;
}

.back {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}

.back-img {
  width: 36rpx;
  height: 36rpx;
}

.ptitle {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pt {
  font-size: 36rpx;
  font-weight: 700;
  color: #11131a;
}

.ps {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.pbody {
  flex: 1;
  min-height: 0;
  /* scroll-view 默认 content-box：只写 padding 的话内容会按整屏宽排，
     右边 28rpx 被挤出屏幕 —— 显式 width + border-box，和「我的」页 .list 一致 */
  width: 750rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.sec {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1.4rpx;
  color: #8a94a6;
  margin: 22rpx 4rpx 12rpx;
}

.fgroup {
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}

.frow {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  height: 96rpx;
}

.frow + .frow {
  border-top: 1rpx solid rgba(120, 134, 155, 0.12);
}

.fk {
  flex: none;
  width: 190rpx;
  font-size: 24rpx;
  color: #33405a;
}

.fv {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 96rpx;
  box-sizing: border-box;
  line-height: 96rpx;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #11131a;
  text-align: right;
  background: transparent;
  vertical-align: middle;
}

.fph {
  color: #b6bfcc;
  font-weight: 500;
  text-align: right;
}

.tb-pad {
  height: 120rpx;
}

.pfoot {
  flex: none;
  padding: 16rpx 28rpx 48rpx;
}

.save {
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #2b96ff, #0060df);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.save:active {
  opacity: 0.92;
}
