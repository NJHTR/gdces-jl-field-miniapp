<view class="page">
  <view class="dhdr" style="padding-top: {{hdrTop}}px;">
    <view class="back" bindtap="onBack" aria-label="返回">
      <image class="back-img" src="/assets/icons/back-dark.png" mode="aspectFit" style="width:36rpx;height:36rpx;" />
    </view>
    <view class="dtitle">
      <text class="dt">{{title}}</text>
      <text class="ds">{{sub}}</text>
    </view>
    <view class="chip {{missingCount ? 'warn' : 'ok'}}">{{missingCount ? '缺 ' + missingCount + ' 项' : '已齐全'}}</view>
  </view>

  <scroll-view class="dbody" scroll-y show-scrollbar="{{false}}">
    <view class="dempty" wx:if="{{!groups.length}}">
      <image class="dempty-img" src="/assets/illus/empty.png" mode="aspectFit" />
      <text class="dempty-t">这份文书还没有内容</text>
      <text class="dempty-s">去「现场」说一句，或者拍张照片，它会自己长出来</text>
    </view>
    <block wx:for="{{groups}}" wx:key="label" wx:for-item="g">
      <view class="sec">{{g.label}}</view>
      <view class="fgroup">
        <view class="frow" wx:for="{{g.rows}}" wx:key="k" wx:for-item="r"
                  data-k="{{r.k}}" bindtap="onEditField">
          <text class="fk">{{r.k}}</text>
          <text class="fv {{r.missing ? 'miss' : ''}}" wx:if="{{!r.missing}}">{{r.v}}</text>
          <text class="fv miss" wx:else>待补 · 点这里填</text>
        </view>
      </view>
    </block>
    <!-- 依据：这份文书凭什么这么写 -->
    <view class="sec">依据</view>
    <view class="basecard">
      <view class="basehead" bindtap="onToggleBases">
        <image class="basehead-i" src="/assets/icons/check-gray.png" mode="aspectFit" />
        <text class="basehead-t">{{bases.length ? bases.length + ' 条依据 · 记录 / 照片 / 规范 / 记忆' : '没有查到依据'}}</text>
        <text class="basehead-more">{{basesOpen ? '收起' : '展开'}}</text>
      </view>
      <view class="baselist" wx:if="{{basesOpen}}">
        <view class="baserow" wx:for="{{bases}}" wx:key="t" data-idx="{{index}}" bindtap="onBasisTap">
          <image class="basei" src="/assets/icons/{{item.ic}}-gray.png" mode="aspectFit" />
          <text class="baset">{{item.t}}</text>
          <text class="basearrow">›</text>
        </view>
      </view>
    </view>

    <!-- 文件：生成的是 Word 文件，不是上面那条记录本身 -->
    <block wx:if="{{docId}}">
      <view class="sec">文件</view>
      <view class="filecard" bindtap="onExportForm">
        <view class="fc-icon"><image class="fc-img" src="/assets/icons/doc-blue.png" mode="aspectFit" /></view>
        <view class="fc-body">
          <text class="fc-t">生成 Word 文件</text>
          <text class="fc-s">按省统表模板生成，可转发/保存</text>
        </view>
        <text class="fc-a">生成 ›</text>
      </view>
      <view class="attachrow" bindtap="onAddAttachment">
        <text class="ar-t">＋ 补充现场附件</text>
        <text class="ar-s">拍照或从相册选择</text>
      </view>
    </block>

    <view class="tb-pad"></view>
  </scroll-view>

  <view class="dfoot" style="padding-bottom: {{bottomPad}}px;">
    <view class="fbtn ghost" wx:if="{{missingCount}}" bindtap="onFillAll" aria-label="补齐缺项">补齐 {{missingCount}} 项</view>
    <view class="fbtn" bindtap="onGenerate" aria-label="提交待签">{{state === '待签' ? '已提交待签' : '提交待签'}}</view>
  </view>
</view>

<!-- 依据原文查看层 -->
<view class="viewer" wx:if="{{viewerOpen}}" catchtap="onViewerClose">
  <view class="viewer-card" catchtap="noop">
    <view class="viewer-head">
      <text class="viewer-title">{{viewerTitle}}</text>
      <view class="viewer-x" catchtap="onViewerClose"><text class="viewer-x-t">✕</text></view>
    </view>
    <scroll-view class="viewer-body" scroll-y>
      <text class="viewer-text">{{viewerBody}}</text>
    </scroll-view>
  </view>
</view>

<!-- 字段编辑：日期用日期选择器，时间用时间选择器，附件拍照/相册 -->
<view class="fsheet" wx:if="{{fieldSheet.open}}" catchtap="onFieldClose">
  <view class="fs-card" catchtap="noop" style="margin-bottom: {{kbHeight}}px;">
    <view class="fs-head">
      <text class="fs-title">{{fieldSheet.key}}</text>
      <view class="fs-x" catchtap="onFieldClose"><text>✕</text></view>
    </view>

    <block wx:if="{{fieldSheet.type === 'date'}}">
      <picker mode="date" value="{{fieldSheet.value}}" bindchange="onFieldDate">
        <view class="fs-pick">
          <text class="fs-pick-t">{{fieldSheet.value || '选择日期'}}</text>
          <text class="fs-pick-a">›</text>
        </view>
      </picker>
    </block>
    <block wx:elif="{{fieldSheet.type === 'time'}}">
      <picker mode="time" value="{{fieldSheet.value}}" bindchange="onFieldTime">
        <view class="fs-pick">
          <text class="fs-pick-t">{{fieldSheet.value || '选择时间'}}</text>
          <text class="fs-pick-a">›</text>
        </view>
      </picker>
    </block>
    <block wx:elif="{{fieldSheet.type === 'photo'}}">
      <text class="fs-hint">补充现场附件（照片）</text>
      <view class="fs-photos">
        <view class="fs-photo" data-source="camera" bindtap="onFieldPhoto">拍照</view>
        <view class="fs-photo ghost" data-source="album" bindtap="onFieldPhoto">从相册选择</view>
      </view>
    </block>
    <block wx:else>
      <textarea class="fs-input" value="{{fieldSheet.value}}" bindinput="onFieldInput" auto-height maxlength="2000" adjust-position="{{false}}" cursor-spacing="24" placeholder="填「{{fieldSheet.key}}」" />
    </block>

    <view class="fs-actions">
      <view class="fs-cancel" bindtap="onFieldClose">取消</view>
      <view class="fs-save" wx:if="{{fieldSheet.type !== 'photo'}}" bindtap="onFieldSave">保存</view>
    </view>
  </view>
</view>