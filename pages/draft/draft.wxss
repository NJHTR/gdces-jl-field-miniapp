page {
  height: 100%;
  background: #f4f7fb;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 顶部 */
.dhdr {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 28rpx 16rpx;
  gap: 16rpx;
}

.back {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}

.back-img {
  width: 36rpx;
  height: 36rpx;
}

.dtitle {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dt {
  font-size: 36rpx;
  font-weight: 700;
  color: #11131a;
}

.ds {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.chip {
  flex: none;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.chip.warn {
  color: #8a4b00;
  background: rgba(255, 233, 197, 0.95);
}

.chip.ok {
  color: #0f6b36;
  background: rgba(226, 250, 236, 0.95);
}

/* 内容 */
.dbody {
  flex: 1;
  min-height: 0;
  /* scroll-view 默认 content-box，只写 padding 右边会被挤出屏幕 */
  width: 750rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.sec {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1.4rpx;
  color: #8a94a6;
  margin: 22rpx 4rpx 12rpx;
}

.fgroup {
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}

.frow {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
}

.frow + .frow {
  border-top: 1rpx solid rgba(120, 134, 155, 0.12);
}

.fk {
  flex: none;
  width: 160rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.fv {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #11131a;
}

.fv.miss {
  color: #c47b00;
}

.tb-pad {
  height: 80rpx;
}

/* 底部 */
.dfoot {
  flex: none;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 16rpx 28rpx 48rpx;
}

.fbtn {
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #2b96ff, #0060df);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.fbtn.ghost {
  flex: none;
  width: 260rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #33405a;
  border: 1rpx solid rgba(120, 134, 155, 0.2);
}

.fbtn:active {
  opacity: 0.9;
}

.dempty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 0;
}

.dempty-img {
  width: 320rpx;
  height: 320rpx;
  opacity: 0.95;
}

.dempty-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #33405a;
}

.dempty-s {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
  text-align: center;
  line-height: 1.55;
}

/* 依据：这份文书凭什么这么写 */
.basecard {
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 36rpx -30rpx rgba(22, 38, 74, 0.45);
  overflow: hidden;
}

.basehead {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 24rpx;
}

.basehead-i {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
}

.basehead-t {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #33405a;
}

.basehead-more {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: #0a6dff;
}

.baselist {
  padding: 0 24rpx 18rpx;
}

.baserow {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(120, 134, 155, 0.12);
}

.basei {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-top: 4rpx;
  opacity: 0.7;
}

.baset {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.5;
  color: #5b6473;
}

/* 依据卡要有实体感：白底 + 细边框 + 轻投影 */
.basecard {
  background: #ffffff;
  border: 1rpx solid rgba(120, 134, 155, 0.16);
  box-shadow: 0 14rpx 30rpx -26rpx rgba(22, 38, 74, 0.5);
}

/* 依据行：可点，右侧箭头 */
.basearrow {
  flex: none;
  font-size: 26rpx;
  color: #c3cbd6;
  margin-left: 8rpx;
}

.baserow:active {
  opacity: 0.9;
}

/* 依据原文查看层 */
.viewer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  background: rgba(12, 16, 24, 0.42);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.viewer-card {
  max-height: 78%;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.viewer-head {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 28rpx 16rpx;
}

.viewer-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #11131a;
}

.viewer-x {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(120, 134, 155, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.viewer-x-t {
  font-size: 24rpx;
  color: #5b6473;
}

.viewer-body {
  flex: 1;
  min-height: 0;
  width: 750rpx;
  box-sizing: border-box;
  padding: 0 28rpx 40rpx;
}

.viewer-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #33405a;
  white-space: pre-wrap;
}

@media (prefers-color-scheme: dark) {
  .viewer-card {
    background: #1c2430;
  }

  .viewer-title {
    color: #eaf1fb;
  }

  .viewer-text {
    color: #c9d4e3;
  }
}
