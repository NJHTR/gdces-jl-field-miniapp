page {
  height: 100%;
  background: #f4f7fb;
}

.page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* 顶部 */
.dhdr {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 28rpx 16rpx;
  gap: 16rpx;
}

.back {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}

.back-img {
  width: 36rpx;
  height: 36rpx;
}

.dtitle {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dt {
  font-size: 36rpx;
  font-weight: 700;
  color: #11131a;
}

.ds {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.chip {
  flex: none;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.chip.warn {
  color: #8a4b00;
  background: rgba(255, 233, 197, 0.95);
}

.chip.ok {
  color: #0f6b36;
  background: rgba(226, 250, 236, 0.95);
}

/* 内容 */
.dbody {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
}

.sec {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1.4rpx;
  color: #8a94a6;
  margin: 22rpx 4rpx 12rpx;
}

.fgroup {
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}

.frow {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx;
}

.frow + .frow {
  border-top: 1rpx solid rgba(120, 134, 155, 0.12);
}

.fk {
  flex: none;
  width: 160rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.fv {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #11131a;
}

.fv.miss {
  color: #c47b00;
}

.tb-pad {
  height: 80rpx;
}

/* 底部 */
.dfoot {
  flex: none;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  padding: 16rpx 28rpx 48rpx;
}

.fbtn {
  flex: 1;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #2b96ff, #0060df);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.fbtn.ghost {
  flex: none;
  width: 260rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #33405a;
  border: 1rpx solid rgba(120, 134, 155, 0.2);
}

.fbtn:active {
  opacity: 0.9;
}

.dempty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 0;
}

.dempty-img {
  width: 320rpx;
  height: 320rpx;
  opacity: 0.95;
}

.dempty-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #33405a;
}

.dempty-s {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
  text-align: center;
  line-height: 1.55;
}
