page {
  height: 100%;
  background: #f2f5fa;
}

.setup {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 48rpx;
  box-sizing: border-box;
}

.setup-card {
  width: 100%;
  padding: 44rpx 36rpx;
  border-radius: 36rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx -36rpx rgba(22, 38, 74, 0.4);
}

.setup-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #11131a;
}

.setup-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.code {
  font-family: Menlo, monospace;
  color: #0060df;
}

.step {
  display: flex;
  margin-top: 34rpx;
}

.step-n {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  margin-right: 18rpx;
  background: #e8f0ff;
  color: #0060df;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
}

.step-b {
  flex: 1;
  min-width: 0;
}

.step-t {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #11131a;
}

.step-d {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a94a6;
}

.setup-btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  background: #0060df;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
