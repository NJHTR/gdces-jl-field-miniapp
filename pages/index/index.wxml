          <view class="recfilter {{recFilter === 'active' ? 'on' : ''}}" data-f="active" bindtap="onRecFilter">待处理</view>
          <view class="recfilter {{recFilter === 'images' ? 'on' : ''}}" data-f="images" bindtap="onRecFilter">现场影像</view>
