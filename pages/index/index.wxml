          <view class="stickybar {{stickyLift ? 'lift' : ''}}">
            <view class="sb-l">
              <text class="sb-d">{{stickyDate}}</text>
              <text class="sb-w">{{stickyWeek}}</text>
            </view>
            <text class="sb-c">{{stickyCount}} 条 · 点这里跳日期</text>
            <view class="sb-today" wx:if="{{showToday}}" catchtap="onBackToday">今天</view>
          </view>
        </picker>

        <!-- 筛选放在滚动容器外：向下滑时不会被吸顶日期条压住 -->
        <view class="recfilters">
