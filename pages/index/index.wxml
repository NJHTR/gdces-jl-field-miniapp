                <image class="mact-img" src="/assets/icons/doc-dark.png" mode="aspectFit" style="width:34rpx;height:34rpx;" />
                <view class="mact-body">
                  <text class="mact-t">导出我的记忆</text>
                  <text class="mact-s">生成一份清单</text>
                </view>
              </view>
              <view class="mact" hover-class="hv" data-act="off" bindtap="onMemoAction">
                <image class="mact-img" src="/assets/icons/warn-dark.png" mode="aspectFit" style="width:34rpx;height:34rpx;" />
                <view class="mact-body">
                  <text class="mact-t">全部停用</text>
                  <text class="mact-s">不影响已经生成的文书</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </view>

      <!-- 录音提示：浮在条上方，不遮挡手指，也不参与触摸 -->
      <view class="recpanel" wx:if="{{recording}}">
        <text class="rp-side {{recMode === 'cancel' ? 'on danger' : ''}}">取消</text>
        <view class="rp-mid">
          <view class="rwave">
            <view class="rbar" wx:for="{{recBars}}" wx:key="*this" style="animation-delay:{{index * 70 % 600}}ms"></view>
          </view>
          <text class="rp-time">{{recTime}}</text>
        </view>
        <text class="rp-side {{recMode === 'convert' ? 'on' : ''}}">转文字</text>
      </view>
      <!-- 点 / 横拖 / 上拉 -->
      <view
        class="dock"
        data-mode="{{dockMode}}"
        data-lensx="{{lensX}}"
        data-lensw="{{lensW}}"
        data-tabw="{{tabbarW}}"
        data-maxh="{{drawerMaxPx}}"
        data-curh="{{drawerH}}"
        bindtouchstart="{{dock.touchstart}}"
        bindtouchmove="{{dock.touchmove}}"
        bindtouchend="{{dock.touchend}}"
        bindtouchcancel="{{dock.touchend}}"
      >

        <view class="capsule {{dockMode === 'input' ? 'composing-mode' : ''}}" bindtouchstart="onGestureStart" bindtouchend="onGestureEnd" bindtouchcancel="onGestureEnd">
          <!-- 搜索形态 -->
          <view class="findbar" wx:if="{{dockMode === 'search'}}">
            <image class="hicon" src="/assets/icons/search-dark.png" mode="aspectFit" style="width:42rpx;height:42rpx;" />
            <input
              class="findinput"
              value="{{querySeed}}"
              focus="{{searchFocus}}"
              adjust-position="{{false}}"
              cursor-spacing="20"
              bindblur="onInputBlur"
              placeholder="{{searchHint}}"
              placeholder-class="findph"
              confirm-type="search"
              bindinput="onQuery"
            />
            <view class="findclear" wx:if="{{query}}" bindtap="clearQuery">
              <text class="findclear-t">✕</text>
            </view>
          </view>

          <!-- 输入形态 -->
          <view class="composing {{recording ? 'recording' : ''}} {{cancel ? 'cancel' : ''}}" wx:elif="{{dockMode === 'input'}}" bindtouchmove="onMicMove" bindtouchend="onMicEnd" bindtouchcancel="onMicEnd">
            <!-- 语音态：键盘切换在左（独立按钮），说话条在中（独立的按压面） -->
            <view class="voicerow" wx:if="{{imMode === 'voice'}}">
              <view
                class="kbswitch {{recording ? 'gone' : ''}}"
                hover-class="kbswitch-on"
                hover-stay-time="60"
                catchtap="toggleImMode"
                aria-label="切换到键盘"
              >
                <image class="kbswitch-img" src="/assets/icons/kbd-dark.png" mode="aspectFit" />
              </view>

              <view
                class="holdbar {{recording ? 'isrec' : ''}}"
                hover-class="holdbar-on"
                hover-stay-time="60"
                bindtouchstart="onMicStart"
                bindtouchmove="onMicMove"
                bindtouchend="onMicEnd"
                bindtouchcancel="onMicEnd"
                aria-label="按住说话"
              >
                <text class="holdbar-t">{{recording ? (recMode === 'cancel' ? '松开取消' : (recMode === 'convert' ? '松开转文字' : '松开结束')) : '按住 说话'}}</text>
              </view>
            </view>
            <!-- 文字态：文字 / 图片 / 语音 自由组合 -->
            <view class="composecol" wx:if="{{!recording && imMode === 'text'}}">
              <!-- 引用条：正在回复哪一条 -->
              <view class="quotebar" wx:if="{{quoting}}">
                <view class="qb-line"></view>
                <text class="qb-t">{{quoting.who}}：{{quoting.text}}</text>
                <view class="qb-x" bindtap="onCancelQuote"><text class="qb-x-t">✕</text></view>
              </view>

              <!-- 附件条：拍了几张、录了几段，都在这儿 -->
              <view class="attachgrid" wx:if="{{attach.length}}">
                <view class="atile" wx:for="{{attach}}" wx:key="id" data-id="{{item.id}}">
                  <image wx:if="{{item.kind === 'photo'}}" class="atile-img" src="{{item.src}}" mode="aspectFill" />
                  <view wx:else class="atile-audio">
                    <view class="atile-wave">
                      <view class="atile-bar" wx:for="{{[12,20,28,18,24,14,22]}}" wx:key="*this" style="height:{{item}}rpx"></view>
                    </view>
                    <text class="atile-dur">{{item.dur}}</text>
                  </view>
                  <view class="atile-x" data-id="{{item.id}}" catchtap="onRemoveAttach">
                    <text class="atile-x-t">✕</text>
                  </view>
                </view>

                <view class="atile atile-add" wx:if="{{attach.length < 9}}" bindtap="onAddAttach">
                  <text class="atile-add-t">＋</text>
                </view>
              </view>

              <!-- 一行只有三个东西：＋ / 输入 / 麦克风或发送 -->
              <view class="holdbar textrow">
                <view
                  class="plusbtn {{attachRecording ? 'rec' : ''}}"
                  bindtap="{{attachRecording ? 'onStopAttach' : 'onAddAttach'}}"
                  aria-label="{{attachRecording ? '停止录音' : '添加图片或语音'}}"
                >
                  <view class="plusbars" wx:if="{{!attachRecording}}">
                    <view class="pb-h"></view>
                    <view class="pb-v"></view>
                  </view>
                  <view class="redsq" wx:else></view>
                  <text class="rectime" wx:if="{{attachRecording}}">{{recDur}}</text>
                </view>

                <view class="fieldwrap">                  <textarea
                    class="ctext"
                    value="{{draftSeed}}"
                    focus="{{imFocus}}"
                    auto-height
                    maxlength="500"
                    adjust-position="{{false}}"
                    bindkeyboardheightchange="onKeyboard"
                    bindblur="onInputBlur"
                    placeholder="说点什么，或拍照"
                    placeholder-class="cph"
                    cursor-spacing="24"
                    bindinput="onType"
                  />
                </view>

                <!-- 右边一个位置，两种功能：有内容=发送，空=切语音 -->
                <view class="send" wx:if="{{hasDraft || attach.length}}" bindtap="onSend" aria-label="发送">
                  <image class="send-img" src="/assets/icons/arrowup-white.png" mode="aspectFit" style="width:34rpx;height:34rpx;" />
                </view>
                <view class="micmode" wx:else catchtap="toggleImMode" aria-label="切到语音">
                  <image class="micmode-img" src="/assets/icons/mic-dark.png" mode="aspectFit" style="width:38rpx;height:38rpx;" />
                </view>
              </view>
              </view>
            </view>

          <!-- 导航形态 -->
          <view class="tabbar" wx:else>
            <view class="lens" style="left: {{lensX}}px; width: {{lensW}}px; transition: {{lensAnim}};"></view>
            <view class="tab {{tab === 'field' ? 'on' : ''}}" data-tab="field" bindtap="switchTab" aria-label="现场">
              <image class="tic-img" src="{{tab === 'field' ? '/assets/icons/bubble-blue.png' : '/assets/icons/bubble-gray.png'}}" mode="aspectFit" style="width:42rpx;height:42rpx;" />
              <text>现场</text>
              <view class="draftdot" wx:if="{{hasDraft && tab !== 'field'}}"></view>
            </view>
            <view class="tab {{tab === 'inbox' ? 'on' : ''}}" data-tab="inbox" bindtap="switchTab" aria-label="记录">
              <image class="tic-img" src="{{tab === 'inbox' ? '/assets/icons/doc-blue.png' : '/assets/icons/doc-gray.png'}}" mode="aspectFit" style="width:42rpx;height:42rpx;" />
              <text>记录</text>
              <view class="pin" wx:if="{{recordPending}}">{{recordPending}}</view>
            </view>
            <view class="tab {{tab === 'me' ? 'on' : ''}}" data-tab="me" bindtap="switchTab" aria-label="我的">
              <image class="tic-img" src="{{tab === 'me' ? '/assets/icons/user-blue.png' : '/assets/icons/user-gray.png'}}" mode="aspectFit" style="width:42rpx;height:42rpx;" />
              <text>我的</text>
            </view>
          </view>
        </view>

        <view class="fab" bindtap="onFab" aria-label="新建记录">
          <image
            class="fic-img"
            mode="aspectFit"
            src="/assets/icons/{{fab === 'bubble' ? 'bubble' : (fab === 'plus' ? 'plus' : (fab === 'down' ? 'down' : 'close'))}}-dark.png"
          />
      </view>
    </view>
  </view>
</view>

</view>