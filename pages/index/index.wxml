          refresher-enabled="{{true}}"
          refresher-triggered="{{refreshing}}"
          bindrefresherrefresh="onRefresh"
        >
        <block wx:if="{{recFilter !== 'images'}}">
        <block wx:for="{{recordsView}}" wx:key="id">
          <view class="dayhd {{index === stickyIdx ? 'hide' : ''}}" id="sec{{index}}">
            <text class="dayhd-d">{{item.date}}</text>
            <text class="dayhd-w">{{item.week}}</text>
            <text class="dayhd-c">{{item.count}} 条</text>
          </view>
          <block wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
            <view class="rcell">
              <!-- 右滑露出签收 -->
              <view class="rsign {{it.state === '已签' ? 'view' : ''}}" data-id="{{it.id}}" bindtap="onSignRow">
                <view class="rsign-in">
                  <image
                    class="rsign-ic"
                    mode="aspectFit"
                    src="{{it.state === '已签' ? '/assets/icons/doc-gray.png' : '/assets/icons/check-green.png'}}"
                    style="width:30rpx;height:30rpx;"
                  />
                  <text class="rsign-t">{{it.state === '已签' ? '查看' : '签收'}}</text>
                </view>
              </view>
              <view
                class="card rslide"
                style="left: {{it.sx || 0}}px;"
                data-kind="{{it.kind}}"
                data-obj="{{it.obj}}"
                data-id="{{it.id}}"
                bindtap="onRecordTap"
                bindtouchstart="onRowStart"
                bindtouchmove="onRowMove"
                bindtouchend="onRowEnd"
                bindtouchcancel="onRowEnd"
              >

              <view class="card-body">
                <view class="card-top">
                  <text class="card-t">{{it.kind}} · {{it.obj}}</text>
                  <text class="st st-{{it.st}}">{{it.state}}</text>
                </view>
                <text class="card-m">{{it.time}}<text class="proj-chip" wx:if="{{it.cross}}"> · {{it.project}}</text></text>
                <view class="chips">
                  <text wx:for="{{it.tags}}" wx:for-item="tg" wx:key="*this" class="chip">{{tg}}</text>
                </view>
              </view>
              <view class="rlclip" wx:if="{{it.sx}}"></view>
              <view class="rcovwrap">
                <image class="rcov" src="/assets/covers/{{it.cov}}.jpg" mode="aspectFill" />
                <view class="rfade"></view>
              </view>
            </view>
            </view>
          </block>
        </block>
        </block>
        <block wx:if="{{recFilter === 'images'}}">
          <block wx:for="{{recImages}}" wx:key="id">
            <view class="dcard" data-name="{{item.name}}" data-id="{{item.id}}" bindtap="onDocTap" bindlongpress="onDocLong">
              <view class="dcard-body">
                <view class="dcard-top">
                  <text class="dname">{{item.name}}</text>
                  <text class="dstate st-{{item.tone}}">{{item.state}}</text>
                </view>
                <text class="dwhen">{{item.meta}}</text>
              </view>
              <view class="rcovwrap dcard-cov">
                <image class="rcov" src="{{item.img}}" mode="aspectFill" />
                <view class="rfade"></view>
              </view>
            </view>
          </block>
        </block>
        <view class="tb-pad"></view>
      </scroll-view>
        </view>

      <scroll-view class="list" scroll-y enable-flex show-scrollbar="{{false}}" style="padding-left:{{padX}}px;padding-right:{{padX}}px;" wx:elif="{{tab === 'docs'}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
        <!-- 图纸与影像：融合卡（图和卡片一体） -->
