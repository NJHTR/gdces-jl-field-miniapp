          <text class="rep-t">生成这几天的巡视记录（docx）</text>
          <text class="rep-a">›</text>
        </view>

        <!-- 文书资料 -->
        <view class="sec">文书资料（与记录同一批）</view>
        <block wx:for="{{docsView}}" wx:key="id">
          <view wx:if="{{!item.visual}}" class="dcard" data-name="{{item.name}}" data-id="{{item.id}}" bindtap="onDocTap" bindlongpress="onDocLong">
            <view class="dcard-body">
              <view class="dcard-top">
                <text class="dname">{{item.name}}</text>
                <text class="dstate st-{{item.tone}}">{{item.state}}</text>
              </view>
              <text class="dwhen">{{item.meta}}</text>
            </view>
            <view class="rcovwrap dcard-cov">
              <image class="rcov" src="{{item.img}}" mode="aspectFill" />
              <view class="rfade"></view>
            </view>
          </view>
        </block>
        <view class="tb-pad"></view>
      </scroll-view>

      <scroll-view class="list" scroll-y enable-flex show-scrollbar="{{false}}" style="padding-left:{{padX}}px;padding-right:{{padX}}px;" wx:else refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
        <!-- 未登录：邀请登录 -->
        <view class="login-card" wx:if="{{!logged}}" bindtap="onLoginTap">
          <view class="lc-body">
            <text class="lc-t">登录后，记录才进项目</text>
