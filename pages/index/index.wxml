              <view class="gi" data-label="图纸" bindtap="onDrawerItem"><image class="gi-img" src="/assets/icons/grid-blue.png" mode="aspectFit" style="width:40rpx;height:40rpx;" /><text>材料报验</text></view>
              <view class="gi" data-label="图纸" bindtap="onDrawerItem"><image class="gi-img" src="/assets/icons/pen-blue.png" mode="aspectFit" style="width:40rpx;height:40rpx;" /><text>检测报告</text></view>
