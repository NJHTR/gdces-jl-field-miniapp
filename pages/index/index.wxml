            <view class="pref-body">
              <text class="pref-t">项目资料</text>
              <text class="pref-s">文书 · 现场影像 · 导出文件</text>
            </view>
            <image class="pref-arrow" src="/assets/icons/chev-dark.png" mode="aspectFit" style="width:28rpx;height:28rpx;" />
          </view>
        </view>

        <view class="sec">偏好</view>
        <view class="prefgroup">
          <view class="prefrow">
            <view class="pref-body">
              <text class="pref-t">触感反馈</text>
