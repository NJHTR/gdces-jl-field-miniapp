<wxs module="dock" src="./dock.wxs"></wxs>
<view class="screen">
  <view class="glow g1"></view>
  <view class="glow g2"></view>
  <view class="glow g3"></view>
  <view class="wm">
    <image class="wm-img" src="/assets/brand-mark.png" mode="aspectFit" />
    <text class="wm-name">{{project.name}}</text>
  </view>

  <view class="app">
    <!-- 顶部：只有「现场」是浮动项目胶囊，其它三页是标题 + 副标题 -->
    <view class="hdr" style="padding-top: {{hdrTop}}px; padding-right: {{hdrRight}}px;" wx:if="{{tab === 'field'}}">
      <view class="project" bindtap="onProjectTap" aria-label="当前项目，点击切换">
        <view class="pico"><image class="pico-img" src="/assets/icons/bld-white.png" mode="aspectFit" style="width:30rpx;height:30rpx;" /></view>
        <view class="pinfo">
          <text class="pname">{{project.name}}</text>
          <text class="psub">{{project.sub}}</text>
        </view>
        <view class="chev"></view>
      </view>

      <view class="iconbtn" bindtap="openSearch" aria-label="搜索">
        <image class="hicon" src="/assets/icons/search-dark.png" mode="aspectFit" style="width:42rpx;height:42rpx;" />
      </view>
    </view>

    <view class="page-hdr" style="padding-top: {{hdrTop}}px; padding-right: {{hdrRight}}px;" wx:else>
      <view class="page-title">
        <text class="pg-h">{{pageTitle}}</text>
        <text class="pg-s">{{pageSub}}</text>
      </view>
      <view class="iconbtn" bindtap="openSearch" aria-label="搜索">
        <image class="hicon" src="/assets/icons/search-dark.png" mode="aspectFit" style="width:42rpx;height:42rpx;" />
      </view>
    </view>

    <!-- 内容（带转场） -->
    <view class="content {{anim}}">
      <view class="srchhd" wx:if="{{query}}">
        <text class="srchhd-t">搜索“{{query}}”</text>
        <text class="srchhd-n">{{searchCount}} 条</text>
      </view>
      <view class="srchempty" wx:if="{{query && searchCount === 0}}">
        <image class="state-img sm" src="/assets/illus/mobile-search.png" mode="aspectFit" />
        <text class="srchempty-t">没有找到相关内容</text>
        <text class="srchempty-s">换个词试试，或者去「现场」直接问它</text>
      </view>

      <!-- 列表本来就没有内容时 -->
      <view class="srchempty" wx:if="{{!query && listEmpty}}">
        <image class="state-img sm" src="/assets/illus/empty.png" mode="aspectFit" />
        <text class="srchempty-t">{{emptyText}}</text>
        <text class="srchempty-s">{{emptySub}}</text>
      </view>
      <!-- 加载中：骨架屏（形状和真实卡片一致，避免跳动） -->
      <block wx:if="{{pageState === 'loading'}}">
        <view class="sk">
          <view class="sk-row" wx:for="{{[1,2,3]}}" wx:key="*this">
            <view class="sk-ico sk-shine"></view>
            <view class="sk-body">
              <view class="sk-line w70 sk-shine"></view>
              <view class="sk-line w40 sk-shine"></view>
            </view>
          </view>
          <view class="sk-row" wx:for="{{[1,2]}}" wx:key="*this">
            <view class="sk-ico sk-shine"></view>
            <view class="sk-body">
              <view class="sk-line w55 sk-shine"></view>
              <view class="sk-line w30 sk-shine"></view>
            </view>
          </view>
        </view>
      </block>

      <!-- 加载失败：插画 + 重试 -->
      <block wx:elif="{{pageState === 'error'}}">
        <view class="statebox">
          <image class="state-img" src="/assets/illus/going-offline.png" mode="aspectFit" />
          <text class="state-t">{{loadErr}}</text>
          <text class="state-s">记录还在本地，不会丢 · 网络回来就能同步</text>
          <view class="state-btn" hover-class="hv" bindtap="onRetry">重试</view>
        </view>
      </block>

      <block wx:else>
      <scroll-view class="tl" scroll-y enable-flex show-scrollbar="{{false}}" scroll-into-view="{{tlAnchor}}" scroll-with-animation="{{true}}" style="padding-left:{{padX}}px;padding-right:{{padX}}px;" wx:if="{{tab === 'field'}}" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
        <block wx:for="{{msgsView}}" wx:key="id">
          <view wx:if="{{item.type === 'stamp' && !item.hidden}}" class="stamp">{{item.text}}</view>

          <view wx:elif="{{item.type === 'photos' && !item.hidden}}" class="row me" style="width:{{rowW}}px;">
            <view class="photos">
              <view wx:for="{{item.n}}" wx:for-item="p" wx:key="*this" class="ph ph{{p}}"></view>
            </view>
            <view class="cap">{{item.cap}}</view>
          </view>

          <view wx:elif="{{item.type === 'me' && !item.hidden}}" class="row me" style="width:{{rowW}}px;">
            <!-- 我发的图：可多张 -->
            <view class="mphotos" wx:if="{{item.photos && item.photos.length}}">
              <image
                wx:for="{{item.photos}}"
                wx:for-item="p"
                wx:key="*this"
                class="mphoto"
                src="{{p}}"
                mode="aspectFill"
                data-src="{{p}}"
                catchtap="onPreviewPhoto"
              />
            </view>

            <block wx:if="{{item.voice}}">
              <view class="me-voice-row">
                <text class="voice-trans-outside" wx:if="{{item.audioSha && !item.transcriptShown}}" catchtap="onVoiceToText" data-id="{{item.id}}">转文字</text>
                <view class="bubble me voice {{item.transcriptShown ? 'has-text' : ''}}" style="width:{{item.bw}}px;" data-id="{{item.id}}" bindlongpress="onMsgLong">
                  <view class="voice-line {{playingVoice === item.id ? 'playing' : ''}}" catchtap="onPlayVoice" data-id="{{item.id}}">
                    <text class="dur">{{playingVoice === item.id ? voicePlayLabel : (item.dur || '0:00')}}</text>
                    <view class="vplay {{playingVoice === item.id ? 'playing' : ''}}">
                      <view class="vtri" wx:if="{{playingVoice !== item.id}}"></view>
                      <view class="vpause" wx:else>
                        <view class="vpause-bar"></view>
                        <view class="vpause-bar"></view>
                      </view>
                    </view>
                  </view>
                  <view class="voice-progress" wx:if="{{playingVoice === item.id}}">
                    <view class="voice-progress-fill" style="width:{{voicePct}}%"></view>
                  </view>
                  <view class="qblock" wx:if="{{item.quote}}">
                    <text class="qblock-who">{{item.quote.who}}</text>
                    <text class="qblock-t">{{item.quote.text}}</text>
                  </view>
                </view>
              </view>
              <view class="voice-transcript {{item.transcriptLong ? 'long' : ''}}" style="width:{{item.transcriptW}}rpx;" wx:if="{{item.transcriptShown}}">
                <text class="voice-transcript-t">{{item.text}}</text>
              </view>
            </block>

            <view class="bubble me" wx:elif="{{item.text}}" style="width:{{item.bw}}px;" data-id="{{item.id}}" bindlongpress="onMsgLong">
              <view class="qblock" wx:if="{{item.quote}}">
                <text class="qblock-who">{{item.quote.who}}</text>
                <text class="qblock-t">{{item.quote.text}}</text>
              </view>
              <view class="quote">{{item.text}}</view>
            </view>

            <!-- 元信息：时间 + 同步状态 + 来源 -->
            <view class="meta">
              <text class="meta-t">{{item.time}}</text>
              <text class="meta-dot">·</text>
              <text class="meta-s {{item.sync ? '' : 'wait'}}">{{item.sync ? '已上传' : '待上传'}}</text>
              <text class="meta-dot" wx:if="{{item.from}}">·</text>
              <text class="meta-s" wx:if="{{item.from}}">{{item.from}}</text>
            </view>
          </view>

          <view wx:elif="{{item.type === 'agent' && !item.hidden}}" class="row agent" style="width:{{rowW}}px;">

            <!-- 执行中：这是一条状态，不是消息。小字、灰、不占气泡 -->
            <view class="proc" wx:if="{{item.pending}}">
              <view class="proc-head">
                <view class="proc-spin"></view>
                <text class="proc-title">处理中 · {{item.elapsed || 0}} 秒</text>
              </view>
              <view class="proc-step" wx:for="{{item.progress}}" wx:for-item="s" wx:key="label">
                <view class="proc-dot {{s.state === 'done' ? 'on' : ''}}"></view>
                <text class="proc-t {{s.state === 'done' ? 'on' : ''}}">{{s.label}}</text>
                <text class="proc-secs" wx:if="{{s.secs}}">{{s.secs}}s</text>
              </view>
              <view class="proc-step" wx:if="{{!item.progress.length}}">
                <view class="proc-dot on"></view>
                <text class="proc-t">正在读项目资料…</text>
              </view>
              <text class="proc-queue" wx:if="{{item.queueAhead > 0}}">前面还有 {{item.queueAhead}} 条在跑</text>
            </view>

            <block wx:else>
              <!-- 过程：两层折叠。外层是整轮，内层每条都能单独开 -->
              <view class="trace" wx:if="{{item.trace && item.trace.length}}">
                <view class="trace-head" data-id="{{item.id}}" catchtap="onTraceToggle">
                  <view class="trace-badge">
                    <image class="trace-badge-i" src="/assets/icons/check-gray.png" mode="aspectFit" />
                  </view>
                  <text class="trace-sum">已完成 · 用时 {{item.msLabel || item.ms}}</text>
                  <text class="trace-more">{{item.traceOpen ? '收起' : '展开'}}</text>
                </view>

                <view class="trace-list" wx:if="{{item.traceOpen}}">
                  <block wx:for="{{item.traceView}}" wx:for-item="t" wx:key="text">

                    <!-- 它说的话：正文级字号，是这一段的主线 -->
                    <text class="tl-note" wx:if="{{t.kind === 'note'}}">{{t.text}}</text>

                    <!-- 它做的事：一行命令，点开看真实命令和输出 -->
                    <view class="tl-item" wx:else data-id="{{item.id}}" data-idx="{{index}}" catchtap="onTraceItem">
                      <view class="tl-line">
                        <view class="tl-badge"><text class="tl-badge-t">›_</text></view>
                        <text class="tl-cmdlabel">{{t.text}}</text>
                        <text class="tl-secs" wx:if="{{t.secs}}">{{t.secs}}s</text>
                        <text class="tl-caret">{{t.open ? '⌄' : '›'}}</text>
                      </view>

                      <view class="tl-body" wx:if="{{t.open}}">
                        <view class="tl-body-head">
                          <text class="tl-body-t">Shell</text>
                          <text class="tl-body-ok {{t.ok ? 'ok' : 'bad'}}">{{t.ok ? '✓ 成功' : '✗ 失败'}}</text>
                        </view>
                        <view class="tl-scroll">
                          <text class="tl-cmd" wx:if="{{t.cmd}}" selectable>$ {{t.cmd}}</text>
                          <text class="tl-cmd" wx:elif="{{t.args}}" selectable>{{t.args}}</text>
                          <text class="tl-out" wx:if="{{t.output}}" selectable>{{t.output}}</text>
                          <text class="tl-out" wx:elif="{{t.text}}" selectable>{{t.text}}</text>
                        </view>
                        <view class="tl-more" data-id="{{item.id}}" data-idx="{{index}}" catchtap="onTraceFull">
                          <text class="tl-more-t">查看完整输出 ›</text>
                        </view>
                      </view>
                    </view>
                  </block>
                </view>
              </view>

              <view class="bubble agent" style="width:{{item.bw}}px;" data-id="{{item.id}}" bindlongpress="onMsgLong">
                <view class="qblock" wx:if="{{item.quote}}">
                  <text class="qblock-who">{{item.quote.who}}</text>
                  <text class="qblock-t">{{item.quote.text}}</text>
                </view>
                <!-- 一段话，重点在句子内部标出来 -->
                <!-- Skyline 里 text 放在 view 下会变块级，必须都塞进同一个 text 父节点才走行内 -->
                <!-- Markdown 块渲染：段落 / 列表 / 小标题 / 分隔线 -->
      <!-- 后端的警示（比如「有文书没入库」）：不许藏失败，直接摆在回答下面 -->
      <view class="warnbar" wx:if="{{item.warning}}">{{item.warning}}</view>

      <!-- 复核意见：默认收起，点一下展开（异步补上的，所以单独一张卡） -->
      <view class="rvcard" wx:if="{{item.review}}">
        <view class="rvhead" bindtap="onToggleReview" data-id="{{item.id}}">
          <text class="rvtitle">复核意见</text>
          <text class="rvmore">{{item.reviewOpen ? '收起' : '展开'}}</text>
        </view>
        <view class="rvbody" wx:if="{{item.reviewOpen}}">
          <block wx:if="{{item.reviewMd && item.reviewMd.length}}">
            <block wx:for="{{item.reviewMd}}" wx:for-item="rb" wx:for-index="rbi" wx:key="rbi">
              <view wx:if="{{rb.t === 'p'}}" class="md-p">
                <text><text wx:for="{{rb.items[0].segs}}" wx:for-item="sg" wx:key="v"
                  class="{{sg.b ? 'md-b' : (sg.c ? 'md-code' : '')}}">{{sg.v}}</text></text>
              </view>
              <view wx:elif="{{rb.t === 'h'}}" class="md-h md-h{{rb.lv}}">
                <text wx:for="{{rb.items[0].segs}}" wx:for-item="sg" wx:key="v"
                  class="{{sg.b ? 'md-b' : ''}}">{{sg.v}}</text>
              </view>
              <view wx:elif="{{rb.t === 'ul'}}" class="md-ul">
                <view class="md-li" wx:for="{{rb.items}}" wx:for-item="it" wx:key="index">
                  <text class="md-dot">·</text>
                  <text class="md-lit"><text wx:for="{{it.segs}}" wx:for-item="sg" wx:key="v"
                    class="{{sg.b ? 'md-b' : (sg.c ? 'md-code' : '')}}">{{sg.v}}</text></text>
                </view>
              </view>
              <view wx:elif="{{rb.t === 'ol'}}" class="md-ul">
                <view class="md-li" wx:for="{{rb.items}}" wx:for-item="it" wx:key="index">
                  <text class="md-dot">{{index + 1}}.</text>
                  <text class="md-lit"><text wx:for="{{it.segs}}" wx:for-item="sg" wx:key="v"
                    class="{{sg.b ? 'md-b' : (sg.c ? 'md-code' : '')}}">{{sg.v}}</text></text>
                </view>
              </view>
              <view wx:elif="{{rb.t === 'table'}}" class="md-tablebox">
                <view class="md-tablescroll">
                  <view class="md-table">
                    <view class="md-tr md-thead">
                      <text class="md-th" wx:for="{{rb.header}}" wx:for-item="cell" wx:key="*this">{{cell}}</text>
                    </view>
                    <view class="md-tr" wx:for="{{rb.rows}}" wx:for-item="row" wx:key="*this">
                      <text class="md-td" wx:for="{{row}}" wx:for-item="cell" wx:key="*this">{{cell}}</text>
                    </view>
                  </view>
                </view>
              </view>
              <view wx:elif="{{rb.t === 'hr'}}" class="md-hr"></view>
            </block>
          </block>
          <text wx:else class="rvplain">{{item.review}}</text>
        </view>
      <!-- 出稿已完成、复核还在后台 -->
      <view class="rvpending" wx:if="{{item.reviewState === 'pending' && !item.review}}">复核中…（文书已出，复核意见稍后补上）</view>
      </view>

      <view class="mdbox" wx:if="{{item.md && item.md.length}}">
        <block wx:for="{{item.md}}" wx:for-item="b" wx:for-index="bi" wx:key="bi">
          <view wx:if="{{b.t === 'p'}}" class="md-p">
            <text><text wx:for="{{b.items[0].segs}}" wx:for-item="sg" wx:key="v"
              class="{{sg.b ? 'md-b' : (sg.c ? 'md-code' : '')}}">{{sg.v}}</text></text>
          </view>

          <view wx:elif="{{b.t === 'h'}}" class="md-h md-h{{b.lv}}">
            <text wx:for="{{b.items[0].segs}}" wx:for-item="sg" wx:key="v"
              class="{{sg.b ? 'md-b' : ''}}">{{sg.v}}</text>
          </view>

          <view wx:elif="{{b.t === 'ul'}}" class="md-ul">
            <view class="md-li" wx:for="{{b.items}}" wx:for-item="it" wx:key="index">
              <text class="md-dot">·</text>
              <text class="md-lit"><text wx:for="{{it.segs}}" wx:for-item="sg" wx:key="v"
                class="{{sg.b ? 'md-b' : (sg.c ? 'md-code' : '')}}">{{sg.v}}</text></text>
            </view>
          </view>

          <view wx:elif="{{b.t === 'ol'}}" class="md-ul">
            <view class="md-li" wx:for="{{b.items}}" wx:for-item="it" wx:key="index">
              <text class="md-dot">{{index + 1}}.</text>
              <text class="md-lit"><text wx:for="{{it.segs}}" wx:for-item="sg" wx:key="v"
                class="{{sg.b ? 'md-b' : (sg.c ? 'md-code' : '')}}">{{sg.v}}</text></text>
            </view>
          </view>

          <view wx:elif="{{b.t === 'hr'}}" class="md-hr"></view>

          <view wx:elif="{{b.t === 'table'}}" class="md-tablebox">
            <view class="md-tablescroll">
              <view class="md-table">
                <view class="md-tr md-thead">
                  <text class="md-th" wx:for="{{b.header}}" wx:for-item="cell" wx:key="*this">{{cell}}</text>
                </view>
                <view class="md-tr" wx:for="{{b.rows}}" wx:for-item="row" wx:key="*this">
                  <text class="md-td" wx:for="{{row}}" wx:for-item="cell" wx:key="*this">{{cell}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>

      <text class="quote rich" wx:elif="{{item.answer && item.answer.rich && item.answer.rich.length}}"><text
                    wx:for="{{item.answer.rich}}" wx:for-item="sg" wx:key="v"
                    class="{{sg.s === 'n' ? 'rt-num' : (sg.s === 'b' ? 'rt-bold' : (sg.s === 'c' ? 'rt-cite' : (sg.s === 'r' ? 'rt-ref' : (sg.s === 'g' ? 'rt-gap' : ''))))}}">{{sg.v}}</text></text>

                <view class="quote" wx:else>{{item.text}}</view>
                <view class="sub" wx:if="{{item.sub}}">{{item.sub}}</view>

                <!-- 多模态资产：一条消息最多一个主卡；同类折叠，其它类型最多 2 行 -->
                <block wx:if="{{item.blocksView && item.blocksView.hasAny}}">
                  <block wx:if="{{item.blocksView.hasPrimary}}">
                    <!-- 图片资产：单图直接看；多图先叠成一组，展开后纵向看全部 -->
                    <view class="apile-card" wx:if="{{item.blocksView.primary.type === 'image'}}">
                      <block wx:if="{{item.assetOpen && item.blocksView.primary.count > 1}}">
                        <view class="aexp-head">
                          <text class="aexp-title">现场照片 · {{item.blocksView.primary.count}} 张</text>
                          <text class="aexp-toggle" catchtap="onAssetExpand" data-id="{{item.id}}">收起</text>
                        </view>
                        <view class="aexp-list">
                          <view
                            class="aexp-cell"
                            wx:for="{{item.blocksView.primary.items}}"
                            wx:for-item="it"
                            wx:for-index="pi"
                            wx:key="key"
                            hover-class="aimg-hv"
                            data-id="{{item.id}}"
                            data-index="{{pi}}"
                            catchtap="onAssetTap"
                          >
                            <image
                              wx:if="{{!it.imgError}}"
                              class="aexp-img"
                              src="{{it.url}}"
                              mode="widthFix"
                              data-id="{{item.id}}"
                              data-key="{{it.key}}"
                              data-asset-id="{{it.assetId}}"
                              binderror="onAssetImgError"
                            />
                            <image wx:else class="aimg-ic" src="/assets/icons/cam-gray.png" mode="aspectFit" />
                            <view class="aimg-no" wx:if="{{it.photoNo}}">{{it.photoNo}}</view>
                          </view>
                        </view>
                      </block>

                      <block wx:else>
                        <view
                          class="apile {{item.blocksView.primary.count > 1 ? 'apile-multi' : 'apile-single'}}"
                        >
                          <image
                            wx:for="{{item.blocksView.primary.layers}}"
                            wx:for-item="ly"
                            wx:for-index="li"
                            wx:key="li"
                            class="apile-layer"
                            style="{{ly.style}}"
                            src="{{ly.url}}"
                            data-id="{{item.id}}"
                            data-key="{{ly.assetId}}"
                            data-asset-id="{{ly.assetId}}"
                            binderror="onAssetImgError"
                            mode="aspectFill"
                          />
                          <image
                            wx:if="{{!item.blocksView.primary.items[0].imgError}}"
                            class="apile-main"
                            src="{{item.blocksView.primary.items[0].url}}"
                            mode="aspectFill"
                            data-id="{{item.id}}"
                            data-index="0"
                            catchtap="onAssetTap"
                            data-key="{{item.blocksView.primary.items[0].key}}"
                            data-asset-id="{{item.blocksView.primary.items[0].assetId}}"
                            binderror="onAssetImgError"
                          />
                          <image wx:else class="apile-main apile-placeholder" src="/assets/icons/cam-gray.png" mode="aspectFit" />
                          <view class="aimg-no" wx:if="{{item.blocksView.primary.items[0].photoNo}}">{{item.blocksView.primary.items[0].photoNo}}</view>
                        </view>
                        <view class="apile-action" wx:if="{{item.blocksView.primary.count > 1}}" catchtap="onAssetExpand" data-id="{{item.id}}">
                          <text class="apile-action-t">展开</text>
                          <text class="apile-action-n">{{item.blocksView.primary.count}}</text>
                        </view>
                      </block>

                      <view class="apile-foot">
                        <view class="apile-head">
                          <text class="apile-title">{{item.blocksView.primary.count > 1 ? '现场照片 · ' + item.blocksView.primary.count + ' 张' : item.blocksView.primary.title}}</text>
                          <text class="ablock-badge {{item.blocksView.primary.badgeTone}}">{{item.blocksView.primary.badgeLabel}}</text>
                        </view>
                        <text class="apile-meta" wx:if="{{item.blocksView.primary.metaText}}">{{item.blocksView.primary.metaText}}</text>
                      </view>
                    </view>

                    <view
                      class="ablock"
                      wx:else
                      hover-class="ablock-hv"
                      data-id="{{item.id}}"
                      catchtap="onAssetTap"
                    >
                      <view class="ablock-thumb">
                        <image class="ablock-ic" src="{{item.blocksView.primary.iconPath}}" mode="aspectFit" />
                      </view>
                      <view class="ablock-body">
                        <view class="ablock-top">
                          <text class="ablock-t">{{item.blocksView.primary.title}}</text>
                          <text class="ablock-badge {{item.blocksView.primary.badgeTone}}">{{item.blocksView.primary.badgeLabel}}</text>
                        </view>
                        <text class="ablock-s" wx:if="{{item.blocksView.primary.metaText}}">{{item.blocksView.primary.metaText}}</text>
                        <text class="ablock-more" wx:if="{{item.blocksView.primary.footText}}">{{item.blocksView.primary.footText}}</text>
                      </view>
                    </view>
                  </block>

                  <view
                    class="arow"
                    wx:for="{{item.blocksView.secondary}}"
                    wx:for-item="ab"
                    wx:key="type"
                    hover-class="ablock-hv"
                    data-id="{{item.id}}"
                    data-type="{{ab.type}}"
                    catchtap="onAssetMoreTap"
                  >
                    <image class="arow-ic" src="{{ab.iconPath}}" mode="aspectFit" />
                    <text class="arow-t">{{ab.title}}</text>
                    <text class="arow-badge {{ab.badgeTone}}">{{ab.badgeLabel}}</text>
                    <text class="arow-f" wx:if="{{ab.footText}}">{{ab.footText}}</text>
                    <image class="arow-chev" src="/assets/icons/chev-gray.png" mode="aspectFit" />
                  </view>

                  <!-- 缺字段 / 坏 URL：留一行文字，不丢信息，也不显示破图 -->
                  <text class="ablock-fb" wx:if="{{item.blocksView.fallbackText}}">{{item.blocksView.fallbackText}}</text>
                </block>

                <!-- 依据：论文式脚注，可点开原文 -->
                <view class="cites" wx:if="{{item.cites && item.cites.length}}">
                  <view class="cite" wx:for="{{item.cites}}" wx:for-item="c" wx:key="clause"
                        data-id="{{item.id}}" data-ci="{{index}}" catchtap="onOpenCite">
                    <text class="cite-n">{{index + 1}}</text>
                    <view class="cite-body">
                      <text class="cite-t">{{c.code}} §{{c.clause}}</text>
                      <text class="cite-std" wx:if="{{c.std}}">{{c.std}}</text>
                    </view>
                  </view>
                </view>

                <!-- 产出物 -->
                <view class="artifact" wx:if="{{item.artifact}}" data-id="{{item.id}}" catchtap="onOpenArtifact">
                  <view class="af-head">
                    <view class="af-icon"><image class="af-img" src="/assets/icons/doc-blue.png" mode="aspectFit" /></view>
                    <view class="af-title">
                      <text class="af-kind">{{item.artifact.kind || "文书"}}</text>
                      <text class="af-name">{{item.artifact.obj || item.artifact.name}}</text>
                    </view>
                    <text class="af-state af-{{item.artifact.state === '已签' ? 'ok' : item.artifact.state === '待补' ? 'need' : 'wait'}}">{{item.artifact.state || "待补"}}</text>
                  </view>
                  <view class="af-foot">
                    <text class="af-gap af-gap-{{item.artifact.missingCount ? 'need' : 'done'}}">{{item.artifact.missText || "字段齐全"}}</text>
                    <text class="af-cta">{{item.artifact.ctaText || "查看"}} ›</text>
                  </view>
                </view>
              </view>

              <view class="meta left">
                <text class="meta-t">{{item.time}}</text>
                <text class="meta-dot" wx:if="{{item.src}}">·</text>
                <text class="meta-s" wx:if="{{item.src}}">{{item.src}}</text>
              </view>
            </block>
          </view>

          </block>
        <view class="tb-pad" id="tl-bottom"></view>
      </scroll-view>

      <view class="inboxwrap" wx:elif="{{tab === 'inbox'}}">
        <!-- 吸顶条：停在顶部，被下一段顶上去 -->
