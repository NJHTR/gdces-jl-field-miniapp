  margin-bottom: 6rpx;
}

.fic-img {
  width: 44rpx;
  height: 44rpx;
}

.cam-img {
  width: 42rpx;
  height: 42rpx;
}

.mic-img {
  width: 42rpx;
  height: 42rpx;
}

.mic-filled {
