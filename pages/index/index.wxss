page {
  height: 100%;
  background: #eef2f8;
}

.screen {
  position: relative;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, #f8fafd, #eef2f8);
}

/* 背景柔光（低透明度，兼容性优先） */
.glow {
  display: none;
}
.g1 {
  width: 560rpx;
  height: 560rpx;
  left: -180rpx;
  top: -200rpx;
  background: rgba(96, 148, 255, 0.14);
}
.g2 {
  width: 460rpx;
  height: 460rpx;
  right: -160rpx;
  top: 60rpx;
  background: rgba(255, 134, 189, 0.1);
}
.g3 {
  width: 520rpx;
  height: 520rpx;
  right: -140rpx;
  bottom: -160rpx;
  background: rgba(70, 224, 171, 0.1);
}

/* 水印 */
.wm {
  position: absolute;
  left: 50%;
  top: 34%;
  width: 300rpx;
  height: 240rpx;
  margin-left: -150rpx;
  opacity: 0.06;
  z-index: 0;
}

.app {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ===== 顶部浮动胶囊 ===== */
.hdr {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 120rpx 28rpx 20rpx;
}

.project {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 22rpx 0 12rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 1rpx 0 #ffffff, 0 16rpx 36rpx -24rpx rgba(22, 38, 74, 0.55);
}

.pico {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #4aa3ff, #0060df);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.5);
}

.pico-t {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.pinfo {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
  margin-right: 14rpx;
}

.pname {
  font-size: 26rpx;
  font-weight: 600;
  color: #11131a;
  line-height: 1.2;
}

.psub {
  font-size: 20rpx;
  color: #8a94a6;
  line-height: 1.3;
  margin-top: 2rpx;
}

.chev {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #9aa4b4;
  border-bottom: 3rpx solid #9aa4b4;
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.iconbtn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 1rpx 0 #ffffff, 0 16rpx 36rpx -26rpx rgba(22, 38, 74, 0.5);
}

.iconbtn-t {
  font-size: 22rpx;
  color: #0a6dff;
  font-weight: 600;
}

/* 放大镜 */
.mag {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}
.mag-c {
  position: absolute;
  left: 0;
  top: 0;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid #33405a;
}
.mag-h {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 12rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #33405a;
  transform: rotate(45deg);
}

/* ===== 时间线 ===== */
.tl {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.stamp {
  text-align: center;
  font-size: 22rpx;
  color: #8a94a6;
  margin: 28rpx 0 16rpx;
}

.row {
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}
.row.me {
  align-items: flex-end;
}
.row.agent {
  align-items: flex-start;
}

.bubble {
  max-width: 520rpx;
  padding: 20rpx 26rpx;
  border-radius: 40rpx;
  box-sizing: border-box;
}

.bubble.me {
  background: linear-gradient(158deg, #2b96ff, #0a6dff 52%, #0053d8);
  border-bottom-right-radius: 14rpx;
  box-shadow: 0 16rpx 32rpx -20rpx rgba(0, 84, 214, 0.9), inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.bubble.agent {
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-bottom-left-radius: 14rpx;
  box-shadow: inset 0 1rpx 0 #ffffff, 0 16rpx 34rpx -26rpx rgba(22, 38, 74, 0.45);
}

.quote {
  font-size: 28rpx;
  line-height: 1.45;
  color: #11131a;
  display: block;
  white-space: normal;
  word-break: break-all;
}

.bubble.me .quote {
  color: #ffffff;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #33405a;
}

/* 语音 */
.voice-line {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}
.wave {
  display: flex;
  align-items: center;
  margin-right: 14rpx;
}
.bar {
  width: 5rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.9);
  margin-right: 4rpx;
}
.dur {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}
.voice-trans {
  margin-left: 16rpx;
  padding: 0 12rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 20rpx;
}

/* 照片 */
.photos {
  display: flex;
  max-width: 100%;
  margin-bottom: 8rpx;
}
.ph {
  width: 168rpx;
  height: 168rpx;
  border-radius: 24rpx;
  margin-left: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
}
.ph1 {
  background: linear-gradient(150deg, #b9c3cc, #59636e);
  margin-left: 0;
}
.ph2 {
  background: linear-gradient(150deg, #c9bfae, #6d6357);
}
.ph3 {
  background: linear-gradient(150deg, #aab6bd, #4e5a64);
}
.ph4 {
  background: linear-gradient(150deg, #c6cbc4, #626a61);
}
.ph5 {
  background: linear-gradient(150deg, #bcc7d2, #5c6773);
}

.cap {
  font-size: 22rpx;
  color: #33405a;
}

.tb-pad {
  height: 220rpx;
}

/* ===== 列表通用 ===== */
.list {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.sec {
  font-size: 22rpx;
  color: #8a94a6;
  margin: 20rpx 4rpx 12rpx;
}

.dayhd {
  display: flex;
  align-items: baseline;
  margin: 26rpx 4rpx 12rpx;
}
.dayhd-d {
  font-size: 28rpx;
  font-weight: 700;
  color: #11131a;
}
.dayhd-w {
  font-size: 22rpx;
  color: #8a94a6;
  margin-left: 12rpx;
}
.dayhd-c {
  font-size: 20rpx;
  color: #a8b2c1;
  margin-left: auto;
}

/* 记录卡片 */
.card {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 18rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset 0 1rpx 0 #ffffff, 0 18rpx 40rpx -30rpx rgba(22, 38, 74, 0.5);
}

.tile {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tone-wait {
  background: linear-gradient(155deg, #ffc25c, #ff9500);
}
.tone-sign {
  background: linear-gradient(155deg, #4aa3ff, #0a6dff);
}
.tone-ok {
  background: linear-gradient(155deg, #4ede84, #1fb457);
}

.tile-doc {
  display: flex;
