}

/* 抽屉收起时不留缝 */
.drawer {
  margin-bottom: 12rpx;
}

/* 水印：图形 + 项目名，压在下方空白 */
.wm {
  position: absolute;
  left: 50%;
  top: auto;
  bottom: 210rpx;
