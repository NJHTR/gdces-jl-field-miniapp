/* ============================================================
   等待回复：三个跳动的点
   ============================================================ */
.thinking {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 0;
}

.tdot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #8a94a6;
  animation: tdot 1.2s infinite ease-in-out;
}

.tdot:nth-child(2) {
  animation-delay: 0.15s;
}

.tdot:nth-child(3) {
  animation-delay: 0.3s;
}

.thinking-t {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

@keyframes tdot {
  0%, 60%, 100% {
    opacity: 0.28;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* ============================================================
   执行中的步骤流
   ============================================================ */
.thinking {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 6rpx 0;
}

.tstep {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.tstep-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(120, 134, 155, 0.35);
}

.tstep-dot.on {
  background: #0a6dff;
}

.tstep-dot.run {
  background: #0a6dff;
  animation: tdot 1.1s infinite ease-in-out;
}

.tstep-t {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: #8a94a6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tstep-t.on {
  color: #33405a;
}

/* ============================================================
   产出物卡片：文书
   ============================================================ */
.artifact {
  margin-top: 18rpx;
  padding: 20rpx 20rpx 16rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(17, 24, 39, 0.08);
  box-shadow: 0 10rpx 30rpx rgba(17, 24, 39, 0.06);
  width: 100%;
  box-sizing: border-box;
}

.af-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 14rpx;
}

.af-icon {
  flex: none;
