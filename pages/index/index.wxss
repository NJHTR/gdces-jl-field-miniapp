  }
}

/* ============================================================
   语音态：两个独立的面
   [⌨ 独立圆钮]  [按住说话 · 扁平条]
   按压反馈轻——只提亮，不变身成主按钮
   ============================================================ */
.voicerow {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  height: 100%;
  padding: 0 6rpx;
  box-sizing: border-box;
}

/* 切换键盘：次要动作，做成独立小圆钮 */
.kbswitch {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx -8rpx rgba(22, 38, 74, 0.4);
}

.kbswitch-on {
  background: #eef4ff;
}

.kbswitch.gone {
  width: 0;
  margin: 0;
  opacity: 0;
  overflow: hidden;
}

.kbswitch-img {
  width: 40rpx;
  height: 40rpx;
}

/* 说话条：扁平、白底、细边。它是"输入区"，不是按钮 */
.holdbar {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 42rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.holdbar-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #33405a;
  letter-spacing: 0.4rpx;
}

/* 按压：只提亮一点，不变蓝 */
.holdbar-on {
  background: #eef4ff;
  border-radius: 42rpx;
}

/* 录音中：用淡蓝表示"正在采集"，文字变白底深蓝字 */
.holdbar.isrec {
  background: #0a6dff;
}

.holdbar.isrec .holdbar-t {
  color: #ffffff;
}

@media (prefers-color-scheme: dark) {
  .kbswitch,
  .holdbar {
    background: #232b38;
  }

  .holdbar-t {
    color: #dfe8f5;
  }

  .holdbar-on {
    background: #2b3648;
  }
}

/* 按压态：字要保持深色（浅蓝底 + 白字看不清） */
.holdbar-on .holdbar-t {
  color: #1c56b8;
}

/* 分区：外层轨道灰一点，两个白块才浮得出来 */
.voicerow {
  background: rgba(120, 134, 155, 0.1);
  border-radius: 42rpx;
  padding: 6rpx;
  gap: 8rpx;
}

.kbswitch,
.holdbar {
  box-shadow: 0 2rpx 8rpx -6rpx rgba(22, 38, 74, 0.45);
}

.holdbar.isrec {
  box-shadow: 0 6rpx 20rpx -12rpx rgba(10, 109, 255, 0.6);
}

@media (prefers-color-scheme: dark) {
  .voicerow {
    background: rgba(255, 255, 255, 0.06);
  }
}

/* ============================================================
   语音态：只保留一层。胶囊本身就是那层白，
   里面直接是「图标 + 灰条」，不再套灰轨道和白圆钮
   ============================================================ */
.voicerow {
  background: transparent;
  border-radius: 0;
  padding: 0;
  gap: 10rpx;
  height: 100%;
  align-items: center;
}

/* 键盘：就是一个图标，不要白底、不要投影 */
.kbswitch {
  width: 76rpx;
  height: 76rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.kbswitch-img {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.62;
}

.kbswitch-on {
  background: transparent;
}

.kbswitch-on .kbswitch-img {
  opacity: 1;
}

/* 说话条：浅灰输入区，和文字态的输入框同一个视觉语言 */
.holdbar {
  height: 84rpx;
  border-radius: 42rpx;
  background: rgba(120, 134, 155, 0.12);
  box-shadow: none;
}

.holdbar-on {
  background: rgba(120, 134, 155, 0.2);
  border-radius: 42rpx;
}

.holdbar-on .holdbar-t {
  color: #11131a;
}

.holdbar.isrec {
  background: #0a6dff;
  box-shadow: none;
}

@media (prefers-color-scheme: dark) {
  .holdbar {
    background: rgba(255, 255, 255, 0.1);
  }

  .holdbar-on {
    background: rgba(255, 255, 255, 0.16);
  }

  .kbswitch-img {
    opacity: 0.7;
  }
}

/* ============================================================
   光学居中：汉字墨迹重心偏低，数学居中会显得下沉
   上 8 / 下 12 → 文字整体上提 2rpx（约 1px），看起来才在中间
   ============================================================ */
.ctext {
  padding: 8rpx 0 12rpx;
}

/* 占位文字跟着同一个盒子，避免focus前后跳动 */
.cph {
  line-height: 40rpx;
}

/* ＋ 号也是字，同样往上提一点 */
.plusbars {
  transform: translateY(-1rpx);
}

/* ============================================================
   顶部项目胶囊：一个胶囊只说一件事
   名称最重要 → 建设单位次要 → 地址进详情，不常驻
   长名字一律单行省略，绝不换行
   ============================================================ */
.pinfo {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  margin-right: 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.pname {
  font-size: 26rpx;
  font-weight: 600;
  color: #11131a;
  line-height: 1.15;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.psub {
  font-size: 21rpx;
  color: #8a94a6;
  line-height: 1.2;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 胶囊宽度跟着内容走，但留出搜索钮的位置，且不换行 */
.project {
  flex: none;
  width: auto;
  max-width: 72%;
  height: 84rpx;
  padding: 0 22rpx 0 10rpx;
  gap: 14rpx;
  border-radius: 42rpx;
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  .pname {
    color: #eaf1fb;
  }
}

/* 步骤行右侧的耗时：小、浅，补充信息 */
.proc-secs {
  flex: none;
  font-size: 20rpx;
  color: #a3adbd;
  font-variant-numeric: tabular-nums;
}

/* 状态区不占满宽，缩在左边，像一句话而不是一块面板 */
.proc {
  align-self: flex-start;
  max-width: 86%;
}

/* ============================================================
   执行过程：两层折叠
   外层「已完成 · 用时 56 秒」→ 内层每条 → 点开看命令和输出
   ============================================================ */
.tl-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 8rpx 0;
}

.tl-line {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 10rpx;
}

.tl-caret {
  flex: none;
  width: 20rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #9aa4b4;
}

.tl-t {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 34rpx;
  color: #33405a;
}

/* 模型的插话：比命令轻一档，斜体区分"它在想"和"它做了" */
.tl-t.note {
  color: #6b7789;
}

.tl-secs {
  flex: none;
  font-size: 20rpx;
  line-height: 34rpx;
  color: #a3adbd;
  font-variant-numeric: tabular-nums;
}

/* 展开后的细节：命令 + 输出 */
.tl-body {
  margin-left: 30rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(120, 134, 155, 0.08);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tl-cmd {
  font-size: 20rpx;
  line-height: 30rpx;
  color: #5b6473;
  word-break: break-all;
}

.tl-out {
  font-size: 20rpx;
  line-height: 30rpx;
  color: #8a94a6;
  word-break: break-all;
}

@media (prefers-color-scheme: dark) {
  .tl-t {
    color: #c9d4e3;
  }

  .tl-t.note {
    color: #9aa4b4;
  }

  .tl-body {
    background: rgba(255, 255, 255, 0.06);
  }
}

/* 时间线文字必须能换行，不能顶出气泡 */
.tl-t,
.tl-cmd,
.tl-out {
  white-space: normal;
  word-break: break-word;
  overflow: hidden;
}

.trace-list {
  width: 100%;
  box-sizing: border-box;
}

/* ============================================================
   过程区（对齐 Codex 的读法）
   叙述 = 正文级字号，是主线
   命令 = 一行小条，点开才看细节
   ============================================================ */

/* 它说的话：和正文同字号，正常颜色，段落感 */
.tl-note {
  display: block;
  font-size: 26rpx;
  line-height: 44rpx;
  color: #11131a;
  padding: 10rpx 0;
  white-space: normal;
  word-break: break-word;
}

/* 命令条：一行，紧凑 */
.tl-item {
  padding: 8rpx 0;
}

.tl-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.tl-badge {
  flex: none;
  width: 40rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: rgba(120, 134, 155, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tl-badge-t {
  font-size: 18rpx;
  color: #6b7789;
  letter-spacing: -1rpx;
}

.tl-cmdlabel {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  line-height: 32rpx;
  color: #5b6473;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tl-caret {
  flex: none;
  width: 18rpx;
  font-size: 22rpx;
  color: #9aa4b4;
  text-align: right;
}

/* 展开：Shell 面板 */
.tl-body {
  margin: 10rpx 0 4rpx 50rpx;
  border-radius: 14rpx;
  background: rgba(120, 134, 155, 0.09);
  border: 1rpx solid rgba(120, 134, 155, 0.14);
  overflow: hidden;
}

.tl-body-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid rgba(120, 134, 155, 0.12);
}

.tl-body-t {
  font-size: 20rpx;
  color: #8a94a6;
  letter-spacing: 1rpx;
}

.tl-body-ok {
  font-size: 19rpx;
}

.tl-body-ok.ok {
  color: #0f8a3c;
}

.tl-body-ok.bad {
  color: #c0392b;
}

.tl-scroll {
  max-height: 360rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
}

.tl-cmd {
  display: block;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #33405a;
  word-break: break-all;
  white-space: normal;
}

.tl-out {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 30rpx;
  color: #8a94a6;
  word-break: break-all;
  white-space: pre-wrap;
}

@media (prefers-color-scheme: dark) {
  .tl-note {
    color: #eaf1fb;
  }

  .tl-cmd {
    color: #c9d4e3;
  }

  .tl-body {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
  }
}

/* 宽度安全：过程区不能顶出气泡 */
.trace,
.trace-list,
.tl-item,
.tl-line {
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.tl-note {
  max-width: 100%;
}

/* 输出区：普通 view，限高裁切（scroll-view 在 Skyline 下高度会塌） */
.tl-scroll {
  max-height: 320rpx;
  overflow: hidden;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
}

.tl-more {
  padding: 10rpx 16rpx 14rpx;
}

.tl-more-t {
  font-size: 21rpx;
  font-weight: 600;
  color: #0a6dff;
}

/* ============================================================
   气泡：重做一版规格
   ------------------------------------------------------------
   1. 用户气泡去渐变、去彩色投影 —— 渐变会让白字对比度不稳定，
      蓝色阴影落在浅灰底上会显脏。纯色 + 无阴影更干净。
   2. AI 气泡从"半透明白 + 白边"改成"纯白 + 极淡描边"：
      长段落压在 78% 白上，边界会糊，宁可要一条 1rpx 的线。
   3. 内边距 10/13 → 14/16：长段落需要呼吸，短句也不会显胖。
   4. 中文长段落行高 1.45 → 1.58，字号 14 → 15px。
   5. 去掉"尖角尾巴"，统一 22px 全圆角 —— 尾巴在小屏长文里
      只会让第一行显得缩进错位。
   ============================================================ */

.bubble {
  padding: 26rpx 32rpx;
  border-radius: 44rpx;
  max-width: 560rpx;
}

/* 用户：纯色，无渐变，无投影 */
.bubble.me {
  background: #0a6dff;
  border-radius: 44rpx;
  box-shadow: none;
}

.bubble.me .quote {
  color: #ffffff;
  font-size: 29rpx;
  line-height: 1.5;
  letter-spacing: 0.2rpx;
}

/* AI：纯白 + 一条极淡的线，靠对比而不是靠阴影 */
.bubble.agent {
  background: #ffffff;
  border: 1rpx solid rgba(17, 19, 26, 0.06);
  border-radius: 44rpx;
  box-shadow: none;
}

.bubble.agent .quote {
  font-size: 30rpx;
  line-height: 1.58;
  letter-spacing: 0.2rpx;
  color: #11131a;
}

/* 引用块：跟着新的内边距重排 */
.bubble .qblock {
  margin-bottom: 12rpx;
}

.bubble .sub {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

/* 时间戳：从 9.5px 提到 11px，淡而不糊 */
.meta-t,
.meta-s {
  font-size: 22rpx;
  letter-spacing: 0.2rpx;
  color: rgba(17, 19, 26, 0.34);
}

.meta-s.wait {
  color: rgba(200, 120, 0, 0.85);
}

/* 消息之间：24 → 28rpx，长段落之间需要更清楚的停顿 */
.row {
  margin-bottom: 28rpx;
}

/* 深色模式：AI 气泡用近黑，别用 96% 那种发灰的黑 */
@media (prefers-color-scheme: dark) {
  .bubble.me {
    background: #0a6dff;
  }

  .bubble.agent {
    background: #1b2230;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .bubble.agent .quote {
    color: #eef3fa;
  }

  .meta-t,
  .meta-s {
    color: rgba(255, 255, 255, 0.4);
  }
}

/* ============================================================
   结构化回答：像一张填好的表单，而不是一段话
   结论 = 加粗正文；依据/待补 = 标签 + 值
   ============================================================ */
.ans {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ans-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 14rpx;
}

.ans-k {
  flex: none;
  width: 56rpx;
  font-size: 21rpx;
  line-height: 34rpx;
  color: rgba(17, 19, 26, 0.34);
  letter-spacing: 0.4rpx;
  padding-top: 8rpx;
}

.ans-v {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.55;
  color: #11131a;
  white-space: normal;
  word-break: break-word;
}

/* 结论是主角，字重加一档 */
.ans-v.strong {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

/* 待补用暖色，提醒"这里需要你补" */
.ans-v.gap {
  color: #8a4b00;
}

.ans-rest {
  display: block;
  margin-top: 4rpx;
  font-size: 27rpx;
  line-height: 1.58;
  color: #5b6473;
  white-space: normal;
  word-break: break-word;
}

@media (prefers-color-scheme: dark) {
  .ans-k {
    color: rgba(255, 255, 255, 0.38);
  }

  .ans-v {
    color: #eef3fa;
  }

  .ans-v.gap {
    color: #ffc266;
  }

  .ans-rest {
    color: #9aa4b4;
  }
}

/* ============================================================
   结构化回答的补充：片段高亮 + 待补 chips
   ============================================================ */

/* 数字：只提字重和一点点底色，不用荧光笔那种色块 */
.seg-num {
  font-weight: 700;
  color: #0a3d91;
  font-variant-numeric: tabular-nums;
}

/* 模型自己标的重点 */
.seg-bold {
  font-weight: 700;
  color: #11131a;
}

/* 待补 chips：点一下就跳到文书那一栏 */
.gapchips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
}

.gapchip {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 176, 32, 0.14);
  border: 1rpx solid rgba(196, 123, 0, 0.22);
  box-sizing: border-box;
}

.gapchip-t {
  font-size: 23rpx;
  color: #8a4b00;
}

.gapchip-plus {
  font-size: 22rpx;
  font-weight: 700;
  color: #c47b00;
}

.ans-rest .seg {
  font-size: 27rpx;
}

@media (prefers-color-scheme: dark) {
  .seg-num {
    color: #8fb6ff;
  }

  .seg-bold {
    color: #ffffff;
  }

  .gapchip {
    background: rgba(255, 176, 32, 0.18);
    border-color: rgba(255, 176, 32, 0.3);
  }

  .gapchip-t {
    color: #ffcf8a;
  }
}

/* 过程区在上、答案在下时的间距 */
.row.agent .trace {
  margin-bottom: 16rpx;
}

.row.agent .bubble.agent {
  margin-top: 0;
}

/* ============================================================
   行内标注：文字仍是一段话，只在句子内部做轻标记
   - 规范号：蓝色 + 虚线下划线（可以点开条文）
   - 待补字段：暖色 + 实线下划线（提示要补）
   - 数字：加重，不加底色

   注意：片段类名统一用 rt-*（见文件末尾），不要再用 .seg 覆盖。
   .seg 是「我的」页和抽屉里的分段控件，把它改成 inline 会把整个
   控件压成一行高，标签叠成两行 —— 2026-11-06 的崩坏就是这个。
   ============================================================ */

.seg-ref {
  color: #0a6dff;
  border-bottom: 1rpx dashed rgba(10, 109, 255, 0.55);
}

.seg-gap {
  color: #8a4b00;
  border-bottom: 1rpx solid rgba(196, 123, 0, 0.5);
}

@media (prefers-color-scheme: dark) {
  .seg-ref {
    color: #8fb6ff;
    border-bottom-color: rgba(143, 182, 255, 0.5);
  }

  .seg-gap {
    color: #ffcf8a;
    border-bottom-color: rgba(255, 207, 138, 0.5);
  }
}

/* ============================================================
   过程区不是卡片，是"说明文字"
   ------------------------------------------------------------
   屏幕上只该有两种盒子：你说的话（蓝）、它说的话（白）。
   过程是旁注，就该像旁注——没有底色、没有边框、没有圆角，
   只是比正文小一号、淡一档的一行字。
   ============================================================ */
.trace-head {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 4rpx 0 8rpx;
  gap: 8rpx;
}

.trace-badge {
  opacity: 0.4;
}

.trace-sum {
  font-size: 23rpx;
  font-weight: 500;
  color: rgba(17, 19, 26, 0.36);
  letter-spacing: 0.2rpx;
}

.trace-more {
  font-size: 23rpx;
  font-weight: 500;
  color: rgba(17, 19, 26, 0.36);
}

/* 展开后：贴着左边给一条极淡的竖线，表示这一段是上一句的展开 */
.trace-list {
  padding: 6rpx 0 6rpx 22rpx;
  border-left: 2rpx solid rgba(17, 19, 26, 0.07);
  margin-left: 10rpx;
}

/* 展开里的命令条：没有底色，只有一行字 */
.tl-item {
  padding: 4rpx 0;
}

.tl-badge {
  background: transparent;
  opacity: 0.45;
}

.tl-cmdlabel {
  color: rgba(17, 19, 26, 0.55);
}

/* Shell 面板：唯一保留的浅底，因为它是"外部内容" */
.tl-body {
  background: rgba(17, 19, 26, 0.03);
  border: none;
  border-radius: 10rpx;
}

@media (prefers-color-scheme: dark) {
  .trace-sum,
  .trace-more {
    color: rgba(255, 255, 255, 0.4);
  }

  .tl-cmdlabel {
    color: rgba(255, 255, 255, 0.6);
  }

  .trace-list {
    border-left-color: rgba(255, 255, 255, 0.1);
  }

  .tl-body {
    background: rgba(255, 255, 255, 0.05);
  }
}

/* 行内换行：让"依据：""待补："各自成段，但仍是一段话的节奏 */
.seg-br {
  display: block;
  height: 12rpx;
}

/* ============================================================
   行内标注只靠颜色 + 字重
   Skyline 里嵌套 text 上的 border / text-decoration 不可靠，
   一旦不生效就会露出奇怪的方框或顶掉基线 —— 只用颜色最稳。
   ============================================================ */
.seg-ref {
  color: #0a6dff;
  border-bottom: none;
}

.seg-gap {
  color: #8a4b00;
  border-bottom: none;
}

.seg-num {
  font-weight: 600;
}

/* 换行片段不需要任何样式 */
.seg-br {
  display: inline;
}

/* ============================================================
   行内标注（改名 rt-，避开分期控件那套 .seg）
   只动颜色和字重，不碰背景、边框、行高 —— 绝不改变排版
   ============================================================ */
.rt-num {
  font-weight: 600;
  color: #0a3d91;
}

.rt-bold {
  font-weight: 700;
  color: #11131a;
}

.rt-cite {
  font-size: 0.72em;
  vertical-align: super;
  line-height: 0;
  color: #1a73e8;
  margin-left: 2rpx;
}

.rt-ref {
  color: #0a6dff;
}

.rt-gap {
  color: #8a4b00;
}

@media (prefers-color-scheme: dark) {
  .rt-num {
    color: #8fb6ff;
  }

  .rt-bold {
    color: #ffffff;
  }

  .rt-ref {
    color: #8fb6ff;
  }

  .rt-gap {
    color: #ffcf8a;
  }
}

/* ============================================================
   Markdown 渲染（模型会写 **加粗** / - 列表 / ### 标题）
   ============================================================ */
.mdbox {
  display: flex;
  flex-direction: column;
}

.md-p {
  font-size: 30rpx;
  line-height: 44rpx;
  color: #1b2028;
  margin-bottom: 10rpx;
}

.md-h {
  font-weight: 700;
  color: #1b2028;
  margin: 8rpx 0 8rpx;
}

.md-h1 { font-size: 34rpx; }
.md-h2 { font-size: 32rpx; }
.md-h3 { font-size: 30rpx; }

.md-ul {
  display: flex;
  flex-direction: column;
  margin: 2rpx 0 10rpx;
}

.md-li {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 6rpx;
}

.md-dot {
  width: 34rpx;
  flex: none;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #7d8798;
  text-align: center;
}

.md-lit {
  flex: 1;
  font-size: 30rpx;
  line-height: 44rpx;
  color: #1b2028;
}

.md-b {
  font-weight: 700;
  color: #10151d;
}

.md-code {
  font-family: Menlo, Consolas, monospace;
  font-size: 26rpx;
  color: #0a6dff;
  background: rgba(10, 109, 255, 0.07);
  border-radius: 6rpx;
}

.md-hr {
  height: 1rpx;
  background: rgba(16, 24, 40, 0.08);
  margin: 10rpx 0;
}

/* Markdown 表格：横向可滚，列宽固定，避免 6 列被挤成一团 */
.md-tablebox {
  width: 100%;
  margin: 8rpx 0 14rpx;
}

.md-tablescroll {
  width: 100%;
}

.md-table {
  display: flex;
  flex-direction: column;
  width: 100%;
  border: 1rpx solid rgba(120, 134, 155, 0.2);
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
}

.md-tr {
  display: flex;
  flex-direction: row;
  border-bottom: 1rpx solid rgba(120, 134, 155, 0.12);
}

.md-tr:last-child {
  border-bottom: none;
}

.md-thead {
  background: #f4f7fb;
}

/* 手机聊天里不横向滚动：列等分铺满气泡，列内换行，至少保证整张表可见 */
.md-th,
.md-td {
  flex: 1 1 0;
  min-width: 0;
  box-sizing: border-box;
  padding: 10rpx 8rpx;
  font-size: 18rpx;
  line-height: 1.4;
  color: #33405a;
  word-break: break-all;
  white-space: normal;
}

.md-th {
  font-size: 18rpx;
  font-weight: 700;
  color: #667085;
}

@media (prefers-color-scheme: dark) {
  .md-table {
    background: #1c2430;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .md-tr {
    border-bottom-color: rgba(255, 255, 255, 0.09);
  }

  .md-thead {
    background: rgba(255, 255, 255, 0.06);
  }

  .md-th,
  .md-td {
    color: #c9d4e3;
  }

  .md-th {
    color: #9aa8ba;
  }
}

/* ============================================================
   复核意见卡（默认收起）
   ============================================================ */
.rvcard {
  margin-top: 12rpx;
  border-radius: 14rpx;
  background: rgba(10, 109, 255, 0.05);
  border: 1rpx solid rgba(10, 109, 255, 0.14);
  overflow: hidden;
}

.rvhead {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
}

.rvtitle {
  font-size: 26rpx;
  font-weight: 600;
  color: #0a6dff;
}

.rvmore {
  font-size: 24rpx;
  color: #0a6dff;
  opacity: 0.75;
}

.rvbody {
  padding: 0 18rpx 16rpx;
  font-size: 27rpx;
  line-height: 40rpx;
  color: #2a3240;
  white-space: normal;
}

.rvbody .md-p {
  font-size: 27rpx;
  line-height: 40rpx;
  color: #2a3240;
  margin-bottom: 8rpx;
}

.rvbody .md-ul {
  margin: 2rpx 0 8rpx;
}

.rvbody .md-h {
  color: #2a3240;
}

.rvplain {
  display: block;
  white-space: pre-wrap;
  font-size: 27rpx;
  line-height: 40rpx;
  color: #2a3240;
}

/* 后端警示（有东西没入库之类） */
.warnbar {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 159, 10, 0.12);
  border: 1rpx solid rgba(255, 159, 10, 0.35);
  color: #8a5200;
  font-size: 25rpx;
  line-height: 36rpx;
}
.rep-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx -12rpx rgba(31, 58, 95, 0.4);
}
.rep-t {
  font-size: 27rpx;
  color: #1f3a5f;
}
.rep-a {
  font-size: 30rpx;
  color: #9aa6b8;
}

.memo-off {
  font-size: 20rpx;
  color: #9aa0a6;
}

.rule-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.rule-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #2f6fed;
  background: rgba(47, 111, 237, 0.08);
}
.rule-btn.on {
  color: #fff;
  background: #2f6fed;
}
/* 次要动作（忽略 / 否决）：中性灰，不跟主按钮抢 */
.rule-btn.mute {
  color: #6b7280;
  background: rgba(120, 134, 155, 0.12);
}

/* 记忆范围标签：跨项目=蓝，本项目/项目规矩=暖灰 */
.scope-chip {
  flex: none;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
  padding: 2rpx 14rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  color: #2f6fed;
  background: rgba(47, 111, 237, 0.09);
}
.scope-chip.proj {
  color: #8a4b00;
  background: rgba(255, 233, 197, 0.95);
}

/* 待确认的两组卡（习惯候选 / 项目规矩）之间留一道呼吸 */
.prefgroup + .prefgroup {
  margin-top: 16rpx;
}

.rvpending {
  margin: 12rpx 24rpx 0;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
}

/* ============================================================
   输入条左侧加号：和外壳胶囊同心
   外胶囊：高约 136rpx，圆角 62rpx
   内按钮：60rpx（半径 30）
   左内边距 = 62 - 30 = 32rpx
   ============================================================ */
.capsule.composing-mode .holdbar.textrow {
  padding-left: 14rpx;
  padding-right: 12rpx;
}

.capsule.composing-mode .plusbtn {
  flex: none;
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  margin: 0;
  padding: 0;
  border-radius: 30rpx;
  background: rgba(120, 134, 155, 0.08);
  box-sizing: border-box;
  transition: background 140ms ease, transform 140ms ease;
}

.capsule.composing-mode .plusbtn:active {
  background: rgba(120, 134, 155, 0.18);
  transform: scale(0.96);
}

.capsule.composing-mode .plusbtn.rec {
  width: auto;
  min-width: 0;
  padding: 0 16rpx 0 12rpx;
  border-radius: 30rpx;
}

.capsule.composing-mode .plusbars {
  width: 24rpx;
  height: 24rpx;
}

.capsule.composing-mode .pb-h {
  width: 24rpx;
}

.capsule.composing-mode .pb-v {
  height: 24rpx;
}

/* 右侧发送/语音与外胶囊同一条垂直中轴 */
.capsule.composing-mode .send,
.capsule.composing-mode .micmode {
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  border-radius: 32rpx;
}

@media (prefers-color-scheme: dark) {
  .capsule.composing-mode .plusbtn {
    background: rgba(255, 255, 255, 0.10);
  }

  .capsule.composing-mode .plusbtn:active {
    background: rgba(255, 255, 255, 0.18);
  }
}

/* ---------- 语音气泡：一条干净的单行，不把“转文字”做成大药丸 ---------- */
.me-voice-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
}

.voice-trans-outside {
  flex: none;
  margin-right: 14rpx;
  padding: 8rpx 4rpx;
  font-size: 22rpx;
  color: #8a94a6;
  letter-spacing: 0.5rpx;
}

.bubble.me.voice {
  max-width: 82%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
  padding: 16rpx 22rpx;
  border-radius: 30rpx;
  border-bottom-right-radius: 12rpx;
}

.bubble.me.voice .voice-line {
  flex-wrap: nowrap;
  align-items: center;
  margin-bottom: 0;
}

.bubble.me.voice .wave {
  flex-wrap: nowrap;
  margin-right: 0;
  margin-left: 12rpx;
}

.bubble.me.voice .bar {
  width: 4rpx;
  margin-right: 3rpx;
  transform-origin: center;
}

.voice-line.playing .bar {
  animation: voice-bar 0.7s ease-in-out infinite alternate;
}

@keyframes voice-bar {
  from { transform: scaleY(0.55); opacity: 0.65; }
  to   { transform: scaleY(1.15); opacity: 1; }
}

/* 语音播放键：不画假波形，用一个克制的播放/暂停圆钮 */
.vplay {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.18s ease, transform 0.18s ease;
}

.vplay.playing {
  background: rgba(255, 255, 255, 0.26);
}

.vtri {
  width: 0;
  height: 0;
  margin-left: 4rpx;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid rgba(255, 255, 255, 0.96);
}

.vpause {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}

.vpause-bar {
  width: 4rpx;
  height: 16rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.96);
}

.voice-progress {
  width: 100%;
  height: 3rpx;
  margin-top: 10rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.18);
  overflow: hidden;
}

.voice-progress-fill {
  height: 100%;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.82);
  transition: width 0.2s linear;
}

.bubble.me.voice .dur {
  font-size: 22rpx;
  letter-spacing: 0.5rpx;
  color: rgba(255, 255, 255, 0.92);
}

.bubble.me.voice.has-text .voice-line {
  margin-bottom: 8rpx;
}

/* 点“转文字”后，文字单独在气泡外，右对齐；和我的语音在同一侧 */
.voice-transcript {
  display: block;
  align-self: flex-end;
  width: auto;
  max-width: 82%;
  min-width: 0;
  box-sizing: border-box;
  margin-top: 10rpx;
  padding: 16rpx 22rpx;
  border-radius: 26rpx;
  border-bottom-right-radius: 10rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 28rpx -24rpx rgba(22, 38, 74, 0.4);
  color: #11131a;
  font-size: 28rpx;
  line-height: 1.45;
  white-space: normal;
  word-break: break-all;
  overflow-wrap: anywhere;
  text-align: left;
}

/* 长转写固定占 82% 宽度，确保在 Skyline 下也强制换行，不越出屏幕 */
.voice-transcript.long {
  width: 82%;
}
