/* ============================================================
   气泡文字溢出修复
   原因：.quote 被设了 width:100%，但气泡是 max-width 收缩宽度，
   两者互相打架 → 文字按 row 宽度排版，超出气泡右边界。
   ============================================================ */

.quote {
  width: auto;
  max-width: 100%;
  white-space: normal;
  word-break: break-all;
}

.bubble {
  box-sizing: border-box;
  max-width: 82%;
  overflow: visible;
}

/* 语音条也不许撑宽气泡 */
