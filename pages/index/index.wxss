    background: rgba(15, 138, 60, 0.18);
    color: #7ce0a0;
  }

  .af-state.af-need {
    background: rgba(138, 75, 0, 0.24);
    color: #ffcf8a;
  }
}

/* 步骤流 / 文书卡片：必须在气泡里裁住，不能顶出去 */
.bubble.agent {
  overflow: hidden;
}

.artifact {
  width: 100%;
  box-sizing: border-box;
}

.tstep {
  min-width: 0;
}

.tstep-t {
  max-width: 100%;
}

/* 排队提示 */
.tqueue {
  margin-top: 6rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(120, 134, 155, 0.16);
}

.tqueue-t {
  font-size: 21rpx;
  color: #c47b00;
}

/* ============================================================
   全局状态条：发送后一直挂在胶囊上方
   不管消息列表滚到哪，都能看到"它在干活 + 已经多少秒"
   ============================================================ */
.busybar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  margin: 0 24rpx 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(10, 109, 255, 0.08);
  border: 1rpx solid rgba(10, 109, 255, 0.16);
  box-sizing: border-box;
}

.bb-spin {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  border-radius: 13rpx;
  border: 4rpx solid rgba(10, 109, 255, 0.25);
  border-top-color: #0a6dff;
  animation: bbspin 0.9s linear infinite;
}

.bb-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.bb-title {
  font-size: 23rpx;
  font-weight: 600;
  color: #0a6dff;
}

.bb-step {
  font-size: 21rpx;
  color: #5b6473;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

@keyframes bbspin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-color-scheme: dark) {
  .busybar {
    background: rgba(10, 109, 255, 0.16);
    border-color: rgba(10, 109, 255, 0.3);
  }

  .bb-step {
    color: #c9d4e3;
  }
}

/* ============================================================
   层级：过程是状态，答案是主角，依据是脚注
   ============================================================ */

/* 执行中：不占气泡，只是一行状态 */
.proc {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 6rpx 4rpx 2rpx;
  max-width: 100%;
}

.proc-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.proc-spin {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  border-radius: 11rpx;
  border: 3rpx solid rgba(10, 109, 255, 0.22);
  border-top-color: #0a6dff;
  animation: bbspin 0.9s linear infinite;
}

.proc-title {
  font-size: 23rpx;
  font-weight: 600;
  color: #0a6dff;
}

.proc-step {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding-left: 4rpx;
}

.proc-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: rgba(120, 134, 155, 0.3);
}

.proc-dot.on {
  background: #0a6dff;
}

.proc-t {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #8a94a6;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.proc-t.on {
  color: #5b6473;
}

.proc-queue {
  font-size: 21rpx;
  color: #c47b00;
}

/* 依据：像论文脚注 */
.cites {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(120, 134, 155, 0.16);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.cite {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.cite-n {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  background: rgba(10, 109, 255, 0.1);
  color: #0a6dff;
  font-size: 19rpx;
  font-weight: 700;
  text-align: center;
  line-height: 30rpx;
}

.cite-body {
  display: flex;
  flex-direction: column;
}

.cite-std {
  font-size: 20rpx;
  color: #8a8f99;
  margin-top: 2rpx;
}

.cite-t {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  color: #0a6dff;
  overflow: hidden;
  white-space: nowrap;
