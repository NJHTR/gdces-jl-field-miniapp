/* 轨迹展开面板：要有实体感，不能是一团白字浮在背景上 */
.trace {
  width: 100%;
  align-self: stretch;
}

.trace-list {
  background: #ffffff;
  border: 1rpx solid rgba(120, 134, 155, 0.18);
  box-shadow: 0 10rpx 24rpx -22rpx rgba(22, 38, 74, 0.5);
}

