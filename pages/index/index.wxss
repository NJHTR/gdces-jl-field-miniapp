  display: block;
  box-sizing: border-box;
}

.bubble {
}

/* 多行正文：用 view 承载，Skyline 里 text 不会自动换行 */
.quote,
.sub,
.memo-t {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.quote {
  white-space: normal;
  word-break: break-all;
}

.sub {
  white-space: normal;
  word-break: break-all;
  margin-top: 8rpx;
}

/* 气泡兜底裁切（万一还有残余溢出，也不会糊到屏幕上） */
.bubble {
  overflow: hidden;
}

/* 气泡宽度改由 JS 计算后行内给出（px），这里只留上限兜底 */
.bubble {
  max-width: 100%;
  box-sizing: border-box;
}

/* ============================================================
   抽屉：位置与开合方式对齐原型
   原型：展开时高度由内容决定（没有写死），开合用 genie 动画
   ============================================================ */

.bottom {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 16rpx 24rpx 0;   /* 左右 12px，和原型一致 */
}

.drawer {
  height: 0;
  overflow: hidden;
  margin: 0;                /* 间距交给 .bottom 的 gap */
  transition: height 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.drawer.open {
  height: auto;
  transition: none;
  animation: drawerGenieIn 0.44s cubic-bezier(0.3, 1.18, 0.4, 1);
  transform-origin: calc(100% - 60rpx) 100%;
}

.drawer.closing {
  animation: drawerGenieOut 0.2s cubic-bezier(0.55, 0.06, 0.68, 0.19) forwards;
  transform-origin: calc(100% - 60rpx) 100%;
}

@keyframes drawerGenieIn {
  0% {
    opacity: 0;
    transform: translate(28rpx, 88rpx) scale(0.38, 0.1);
    filter: blur(10rpx);
  }
  55% {
    opacity: 1;
    transform: translate(0, -12rpx) scale(1.04, 1.06);
    filter: blur(0);
  }
  100% {
    opacity: 1;
    transform: none;
  }
}

@keyframes drawerGenieOut {
  0% {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }
  100% {
    opacity: 0;
    transform: translate(32rpx, 96rpx) scale(0.4, 0.08);
    filter: blur(8rpx);
  }
}

/* 拖动中不要过渡，交给 WXS 直接改高度 */
.drawer.dragging {
  transition: none;
  animation: none;
}

.composer {
  margin: 0;
}

.dock {
