  margin-top: 5rpx;
}
.ic-foldertab {
  position: absolute;
  left: -2.5rpx;
  top: -8rpx;
  width: 14rpx;
  height: 8rpx;
  border: 2.5rpx solid #6b7789;
  border-bottom: none;
  border-radius: 3rpx 3rpx 0 0;
  background: transparent;
}

.ic-user {
  flex-direction: column;
  justify-content: flex-start;
}
.ic-head {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2.5rpx solid #6b7789;
  background: transparent;
  margin-top: 1rpx;
}
.ic-shoulder {
  width: 22rpx;
  height: 10rpx;
  border: 2.5rpx solid #6b7789;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
