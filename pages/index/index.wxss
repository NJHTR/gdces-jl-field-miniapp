  height: 52rpx;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #eaf3ff, #dcebff);
  display: flex;
  align-items: center;
  justify-content: center;
}

.af-img {
  width: 30rpx;
  height: 30rpx;
}

.af-title {
  flex: 1;
  min-width: 0;
