  margin-left: 20rpx;
}

.card-top {
  display: flex;
  align-items: center;
}

.card-t {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #11131a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-m {
  display: block;
