  background: #ff6a5e;
  animation: waveBar 0.72s ease-in-out infinite;
}

.rp-time {
  font-size: 22rpx;
  font-weight: 700;
  color: #d92c20;
}

/* 录音中的条：只变底色，不再放第二套 UI */
.holdbar.isrec {
  justify-content: center;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.95);
}

.recording-t {
  color: #33405a;
}

/* 录音时图标隐去（不销毁节点，触摸链才不断） */
.imtoggle.gone {
  width: 0;
  margin: 0;
  opacity: 0;
  overflow: hidden;
}

/* 录音时条里的文字居中 */
.holdbar.isrec {
  justify-content: center;
}

/* ============================================================
   搜索：明确告诉你"在搜什么、搜到几条"
   ============================================================ */

.srchhd {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding: 4rpx 40rpx 14rpx;
}

.srchhd-t {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #33405a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.srchhd-n {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #8a94a6;
}

.srchempty {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 0;
}

.srchempty-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #33405a;
}

.srchempty-s {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

/* ============================================================
   水印：对齐原型最终版
   图 112px 宽、透明度 8.5%、距底 112px
   项目名 11px / 字距 .34em / 透明度 26%
   ============================================================ */

.wm {
  bottom: 224rpx;
  width: 320rpx;
  margin-left: -160rpx;
}

.wm-img {
  width: 224rpx;
  height: 177rpx;
  opacity: 0.085;
}

.wm-name {
  margin-top: 20rpx;
  font-size: 22rpx;
  letter-spacing: 0.34em;
  text-indent: 0.34em;
  color: #24304a;
  opacity: 0.26;
}

/* ============================================================
   我的页：已登录的身份卡（用身份说明状态，不写"已登录"）
   ============================================================ */

.idcard {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset 0 1rpx 0 #ffffff, 0 16rpx 36rpx -30rpx rgba(22, 38, 74, 0.45);
}

.idavatar {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #62b4ff, #1a86ff 45%, #0062e0);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
}

.idbody {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.idname {
  font-size: 28rpx;
  font-weight: 600;
  color: #11131a;
}

.idsub {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #8a94a6;
}

/* 退出登录 */
.logout {
  margin-top: 24rpx;
  padding: 24rpx 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.logout-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #d92c20;
}

.pref-arrow {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
  opacity: 0.5;
}

/* 输入框里的"粘贴"提示条 */
.pastechip {
  flex: none;
  max-width: 320rpx;
  height: 60rpx;
  padding: 0 20rpx;
  margin-right: 8rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  background: rgba(10, 109, 255, 0.1);
  overflow: hidden;
}

.pastechip-t {
  font-size: 22rpx;
  font-weight: 600;
  color: #0a6dff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ============================================================
   四态：骨架屏 / 失败 / 空 / 正常
   插画来自 unDraw（开源，可商用），已统一成品牌蓝三阶
   ============================================================ */

.sk {
  padding: 8rpx 40rpx 0;
}

.sk-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.sk-ico {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  margin-right: 22rpx;
}

.sk-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.sk-line {
  height: 22rpx;
  border-radius: 11rpx;
  margin-bottom: 14rpx;
}

.sk-line.w70 { width: 70%; }
.sk-line.w40 { width: 40%; margin-bottom: 0; }
.sk-line.w55 { width: 55%; }
.sk-line.w30 { width: 30%; margin-bottom: 0; }

/* 流光：从左扫到右 */
.sk-shine {
  background: linear-gradient(100deg, rgba(214, 226, 242, 0.85) 20%, rgba(238, 244, 252, 0.95) 42%, rgba(214, 226, 242, 0.85) 64%);
  background-size: 300% 100%;
  animation: shimmer 1.35s ease-in-out infinite;
}

@keyframes shimmer {
  0% { background-position: 140% 0; }
  100% { background-position: -40% 0; }
}

/* 失败 / 空状态 */
.statebox {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 56rpx 0;
}

.state-img {
  width: 380rpx;
  height: 380rpx;
  opacity: 0.95;
}

.state-t {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b3a55;
}

.state-s {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #8a94a6;
  text-align: center;
  line-height: 1.55;
}

.state-btn {
  margin-top: 28rpx;
  padding: 20rpx 52rpx;
  border-radius: 40rpx;
  background: linear-gradient(160deg, #2b96ff, #0060df);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 28rpx -18rpx rgba(0, 84, 214, 0.9);
}


/* 搜索/空列表用的插画小一号 */
.state-img.sm {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 4rpx;
}

.srchempty {
  padding-top: 30rpx;
  /* 空状态下面是列表（我的页是登录卡），留一口气，别贴在一起 */
  padding-bottom: 24rpx;
}

/* ============================================================
   气泡长按菜单
   ============================================================ */

.msk {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 300;
  background: rgba(12, 16, 24, 0.28);
}

.lmenu {
  position: absolute;
  width: 220rpx;
  padding: 10rpx 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid rgba(255, 255, 255, 0.98);
  box-shadow: 0 28rpx 60rpx -28rpx rgba(22, 38, 74, 0.6);
  overflow: hidden;
}

.lmenu-i {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 24rpx;
}


.lmenu-img {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.8;
}

.lmenu-t {
  font-size: 24rpx;
  font-weight: 600;
  color: #11131a;
}

.lmenu-i.danger .lmenu-t {
  color: #d92c20;
}

/* ============================================================
   记录行：右滑露出签收
   ============================================================ */

.rcell {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
}


.rsign-t {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.card.rslide {
  position: relative;
  left: 0;
  transition: left 0.26s cubic-bezier(0.34, 1.2, 0.64, 1);
}

/* ============================================================
   深色模式：只覆盖"面"的颜色，不改结构
   ============================================================ */

@media (prefers-color-scheme: dark) {
  page {
    background: #0d1219;
  }

  .screen {
    background: #0d1219;
  }

  .card,
  .prefgroup,
  .idcard,
  .login-card,
  .mact,
  .srchhd,
  .sk-row,
  .lmenu,
  .statebox {
    background: rgba(28, 36, 48, 0.92);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .hdr,
  .page-hdr {
    color: #eaf1fb;
  }

  .page-title h2,
  .card-t,
  .pref-t,
  .mact-t,
  .idname,
  .state-t,
  .empty-t {
    color: #eaf1fb;
  }

  .page-title p,
  .card-m,
  .pref-s,
  .mact-s,
  .idsub,
  .state-s {
    color: #8b9bb0;
  }

  .bubble.agent {
    background: rgba(34, 43, 58, 0.96);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .bubble.agent .quote,
  .bubble.agent .sub {
    color: #dfe8f5;
  }

  .capsule,
  .holdbar,
  .textrow {
    background: rgba(34, 43, 58, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .holdbar-t,
  .ctext {
    color: #eaf1fb;
  }

  .cph {
    color: #6f7f94;
  }

  .lens {
    background: rgba(92, 122, 170, 0.55);
  }

  .tab .tic + text,
  .tab text {
    color: #8b9bb0;
  }

  .tab.on text {
    color: #eaf1fb;
  }

  .stamp {
    color: #6f7f94;
  }

  .wm-name {
    color: #dfe8f5;
  }

  .bottom {
    background: linear-gradient(to top, #0d1219 18%, rgba(13, 18, 25, 0.94) 62%, rgba(13, 18, 25, 0));
  }
}

/* ============================================================
   记录卡片：右侧封面（柔底 + 3D 小场景），不是光秃秃一个图标
   ============================================================ */

.rcov {
  flex: none;
  width: 172rpx;
  height: 120rpx;
  margin-left: 16rpx;
  border-radius: 18rpx;
  background: #eaf2fe;
}

/* 卡片必须不透明：否则左滑时底下的"签收"会透出来 */
.card.rslide {
  background: #ffffff;
}

/* 签收按钮：待签=绿，已签=中性蓝灰，一眼能分清 */


@media (prefers-color-scheme: dark) {
  .card.rslide {
    background: #1c2430;
  }

  .rcov {
    background: #202a38;
  }
}

/* 左滑改为「缩窄」而不是「整卡左移」：
   文字用省略号收尾，不会被屏幕左边切掉 */
.card.rslide {
  position: relative;
  left: 0;
  transition: margin-right 0.26s cubic-bezier(0.34, 1.2, 0.64, 1);
}


.rsign-t {
  font-size: 24rpx;
}

.card-body .card-t {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============================================================
   融合卡片：图占到卡片右半，左缘渐隐进白底
   —— 不是一个圆角小方块贴在旁边，而是卡片自己"长出"一张图
   ============================================================ */

.card.rslide {
  padding-right: 0;
  overflow: hidden;
  align-items: stretch;
  min-height: 168rpx;
}

.card.rslide .card-body {
  padding: 22rpx 12rpx 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.rcovwrap {
  position: relative;
  flex: none;
  width: 260rpx;
  margin-left: 12rpx;
  border-radius: 0;
  overflow: hidden;
}

.rcov {
  width: 100%;
  height: 100%;
  border-radius: 0;
  margin: 0;
  background: #eef4fb;
}

/* 左缘渐隐：用的不是 mask（Skyline 不支持），而是一层同色渐变盖在图上 */
.rfade {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 96rpx;
  background: linear-gradient(to right, #ffffff 0%, rgba(255, 255, 255, 0.75) 42%, rgba(255, 255, 255, 0) 100%);
}

@media (prefers-color-scheme: dark) {
  .rfade {
    background: linear-gradient(to right, #1c2430 0%, rgba(28, 36, 48, 0.75) 42%, rgba(28, 36, 48, 0) 100%);
  }
}

/* 按压缩放都去掉了（Skyline 不支持 :active），
   只保留一条通用的 hover 反馈，需要的地方用 hover-class="hv" */
.hv {
  opacity: 0.84;
}

/* ============================================================
   左滑动作：浮起的小圆角按钮，不是一条实色色块
   ============================================================ */


.rsign-in {
  width: 104rpx;
  height: 104rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: #e7f8ed;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.rsign-ic {
  width: 30rpx;
  height: 30rpx;
}

.rsign-t {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f8a3c;
  letter-spacing: 0.4rpx;
}

/* 已签：蓝色系，动作是"翻看"而不是"确认" */
.rsign.view .rsign-in {
  background: #e8f0ff;
}

.rsign.view .rsign-t {
  color: #0a6ddf;
}

/* 卡片被推开时加一点右侧投影，做出层次 */
.card.rslide {
  box-shadow: 8rpx 0 20rpx -12rpx rgba(22, 38, 74, 0.28), 0 10rpx 22rpx -18rpx rgba(22, 38, 74, 0.5);
}

@media (prefers-color-scheme: dark) {
  .rsign-in {
    background: rgba(28, 180, 96, 0.18);
  }

  .rsign.view .rsign-in {
    background: rgba(43, 150, 255, 0.18);
  }

  .rsign-t {
    color: #4ade80;
  }

  .rsign.view .rsign-t {
    color: #7fb6ff;
  }
}

/* ============================================================
   整卡滑动：卡片整体左移，裁切发生在屏幕边缘（不是卡片自己变窄）
   ============================================================ */

.inboxlist {
  padding-left: 0;
  padding-right: 0;
}

.inboxlist .sec,
.inboxlist .dayhd {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

/* 现场影像卡：记录页是通栏滚动容器，卡片必须自己留出左右页边距 */
.inboxlist .dcard {
  margin-left: 40rpx;
  margin-right: 40rpx;
}

.rcell {
  border-radius: 0;
  margin: 0 0 18rpx;
}

.card.rslide {
  margin: 0 40rpx;
  padding-right: 0;
  transition: left 0.26s cubic-bezier(0.34, 1.2, 0.64, 1);
}

/* 动作按钮贴右边缘，和卡片右边距对齐 */

/* 左缘渐隐：卡片滑走后，用一层和页面同色的渐变吃掉"被切掉"的硬边 */
.rlclip {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 56rpx;
  z-index: 3;
  background: linear-gradient(to right, #f2f5fa 0%, rgba(242, 245, 250, 0.82) 46%, rgba(242, 245, 250, 0) 100%);
  border-radius: 28rpx 0 0 28rpx;
}

@media (prefers-color-scheme: dark) {
  .rlclip {
    background: linear-gradient(to right, #0d1219 0%, rgba(13, 18, 25, 0.82) 46%, rgba(13, 18, 25, 0) 100%);
  }
}

/* ============================================================
   吸顶日期条（pinned section header）
   滚动时停在顶部，下一段上来把它顶走
   ============================================================ */

.inboxwrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  position: relative;
}

.recfilters {
  flex: none;
  display: flex;
  flex-direction: row;
  margin: 14rpx 28rpx 8rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: rgba(120, 134, 155, 0.11);
}

.recfilter {
  flex: 1;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  background: transparent;
  color: #667085;
  font-size: 23rpx;
  line-height: 1;
  font-weight: 500;
  transition: background 160ms ease, color 160ms ease;
}

.recfilter.on {
  background: #ffffff;
  color: #11131a;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(30, 42, 60, 0.08);
}

@media (prefers-color-scheme: dark) {
  .recfilters {
    background: rgba(255, 255, 255, 0.09);
  }

  .recfilter {
    color: #9aa8ba;
  }

  .recfilter.on {
    background: #2a3544;
    color: #ffffff;
    box-shadow: none;
  }
}

.recsummary {
  flex: none;
  padding: 0 40rpx 10rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #8a94a6;
  letter-spacing: 0.2rpx;
}

.stickybar {
  flex: none;
  height: 84rpx;
  margin: 0 40rpx 8rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 12rpx 26rpx -20rpx rgba(22, 38, 74, 0.5);
  transition: transform 0.18s cubic-bezier(0.34, 1.2, 0.64, 1), opacity 0.18s ease;
}

/* 被下一段顶上去的那一下 */
.stickybar.lift {
  transform: translateY(-10rpx);
  opacity: 0.86;
}

.sb-l {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 10rpx;
}

.sb-d {
  font-size: 24rpx;
  font-weight: 700;
  color: #11131a;
  letter-spacing: 0.2rpx;
}

.sb-w {
  font-size: 22rpx;
  font-weight: 500;
  color: #8a94a6;
}

.sb-c {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 20rpx;
  color: #a3adbb;
}

.sb-today {
  flex: none;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(10, 109, 255, 0.1);
  color: #0a6dff;
  font-size: 22rpx;
  font-weight: 700;
}

@media (prefers-color-scheme: dark) {
  .stickybar {
    background: rgba(34, 43, 58, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .sb-d {
    color: #eaf1fb;
  }

  .sb-today {
    background: rgba(43, 150, 255, 0.2);
    color: #7fb6ff;
  }
}

/* 被吸顶条"吸收"的那一段日期头：隐藏但保留高度，避免内容跳动 */
.dayhd.hide {
  opacity: 0;
}

/* 「查看」是中性动作：不用品牌蓝，用中性灰白
   —— 蓝色在这个 app 里留给"主要操作"（发送、登录），别抢语义 */
.rsign.view .rsign-in {
  background: #f2f4f8;
  border: 1rpx solid rgba(120, 134, 155, 0.16);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.rsign.view .rsign-t {
  color: #33405a;
}

@media (prefers-color-scheme: dark) {
  .rsign.view .rsign-in {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .rsign.view .rsign-t {
    color: #c9d4e3;
  }
}

/* 左滑动作容器：绝对定位在卡片右侧下方，本身不画任何底色 */

.rsign.view {
  background: transparent;
}
/* ============================================================
   左滑动作：不做一个"贴纸"，而是做一张和卡片同高同圆角的动作卡
   —— 卡片滑开，后面本来就站着一张卡，而不是缝隙里塞了个按钮
   ============================================================ */

.rsign {
  position: absolute;
  right: 40rpx;
  top: 0;
  bottom: 0;
  width: 148rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 28rpx;
  background: #e7f8ed;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9), 0 10rpx 22rpx -18rpx rgba(22, 38, 74, 0.5);
}

.rsign.view {
  background: #f2f4f8;
}

/* 动作卡里的图标和文字直接居中，不再套一层小方块 */
.rsign-in {
  width: auto;
  height: auto;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  gap: 8rpx;
}

.rsign.view .rsign-in {
  background: transparent;
  border: none;
  box-shadow: none;
}

.rsign-ic {
  width: 34rpx;
  height: 34rpx;
}

.rsign-t {
  font-size: 22rpx;
  font-weight: 700;
}

@media (prefers-color-scheme: dark) {
  .rsign {
    background: rgba(28, 180, 96, 0.16);
  }

  .rsign.view {
    background: rgba(255, 255, 255, 0.08);
  }

  .rsign-in,
  .rsign.view .rsign-in {
    background: transparent;
  }
}
/* 资料行：实拍缩略图（和记录页的封面语言一致） */
.dthumb-img {
  width: 84rpx;
  height: 84rpx;
  border-radius: 22rpx;
  background: #eef4fb;
}

/* ============================================================
   组合输入：附件条 + 自动增高的文字 + 录音/拍照
   ============================================================ */

.composecol {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.attachgrid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 12rpx 14rpx;
  /* 最多 9 张 + 1 个添加位，两行足够；多出来裁掉，绝不顶出输入框 */
  max-height: 264rpx;
  overflow: hidden;
}

.atile {
  position: relative;
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eef3f9;
  border: 1rpx solid rgba(16, 24, 40, 0.06);
}

.atile-img {
  /* image 默认 inline，底部会多几像素基线空隙，缩略图就不齐了 */
  display: block;
  width: 100%;
  height: 100%;
}

.atile-audio {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(160deg, #e9f1ff 0%, #dbe8ff 100%);
}

.atile-wave {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 5rpx;
  height: 30rpx;
}

.atile-bar {
  width: 4rpx;
  border-radius: 2rpx;
  background: #0a6dff;
}

.atile-dur {
  font-size: 20rpx;
  font-weight: 600;
  color: #0a6dff;
  letter-spacing: 0.2rpx;
}

.atile-x {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: rgba(12, 16, 24, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}

.atile-x-t {
  font-size: 18rpx;
  color: #ffffff;
  line-height: 1;
}

.atile-add {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 109, 255, 0.05);
  border: 2rpx dashed rgba(10, 109, 255, 0.35);
}

.atile-add-t {
  font-size: 44rpx;
  line-height: 1;
  color: #0a6dff;
  opacity: 0.75;
}

/* 文字框：自动增高，最多 5 行后内部滚动 */
.ctext {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 300rpx;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #11131a;
  background: transparent;
}

/* 录音 / 拍照小按钮 */
.micbtn {
  position: relative;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
}

.micbtn-img {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.75;
}

.micbtn-dot {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #ff3b30;
}

/* 我发的多图 */
.mphotos {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
  margin-bottom: 8rpx;
  max-width: 100%;
}

.mphoto {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #dde6f2;
}

/* ============================================================
   资料页：融合卡（和记录页同一套语言）
   文字在左，图从右半长出来，左缘渐隐
   ============================================================ */

.dcard {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 168rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx -30rpx rgba(22, 38, 74, 0.45);
}

.dcard:active {
  opacity: 0.96;
}

.dcard-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx 8rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.dcard-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dcard .dname {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #11131a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dcard .dstate {
  flex: none;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
}

.dcard .dwhen {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.dcard-cov {
  width: 220rpx;
}

.dcard-cov .rcov {
  width: 100%;
  height: 100%;
}

.dcard-cov .rfade {
  width: 80rpx;
}

@media (prefers-color-scheme: dark) {
  .dcard {
    background: #1c2430;
  }

  .dcard .dname {
    color: #eaf1fb;
  }
}

/* 记忆条目：从"每条一张浮卡"改成"一组里的行"，减少阴影噪音 */
.memo {
  padding: 26rpx 24rpx;
  margin: 0;
  border-radius: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.memo + .memo {
  border-top: 1rpx solid rgba(120, 134, 155, 0.12);
}

.memo:first-child {
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
}

.memo:last-child {
  border-bottom-left-radius: 28rpx;
  border-bottom-right-radius: 28rpx;
}

/* 首次使用的提示：底部上方一条，一次性 */
.coach {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 260rpx;
  z-index: 220;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(20, 26, 36, 0.92);
  box-shadow: 0 24rpx 50rpx -28rpx rgba(0, 0, 0, 0.6);
}

.coach-t {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.94);
}

.coach-x {
  flex: none;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 21rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 录一段：红色圆点，和"麦克风（切语音模式）"明确区分 */
.refbtn {
  width: 64rpx;
  height: 64rpx;
}

.refdot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #ff3b30;
  box-shadow: 0 0 0 6rpx rgba(255, 59, 48, 0.16);
}

.refbtn.on .refdot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 6rpx;
  background: #ff3b30;
  box-shadow: 0 0 0 10rpx rgba(255, 59, 48, 0.14);
}

/* ============================================================
   组合输入：一行三个东西
   ＋（附件） / 输入框 / 麦克风或发送
   ============================================================ */

.plusbtn {
  flex: none;
  height: 64rpx;
  min-width: 64rpx;
  padding: 0 6rpx;
  border-radius: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.plus-t {
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  color: #5b6473;
  margin-top: -4rpx;
}

.plusbtn.rec {
  padding: 0 18rpx 0 12rpx;
  background: rgba(255, 59, 48, 0.1);
}

.redsq {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: #ff3b30;
}

.rectime {
  font-size: 22rpx;
  font-weight: 700;
  color: #ff3b30;
  font-variant-numeric: tabular-nums;
}

.micmode {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.micmode-img {
  width: 38rpx;
  height: 38rpx;
  opacity: 0.7;
}

/* ============================================================
   输入框垂直居中修正
   问题：textarea 自带默认行高和内边距，min-height 撑高后文字贴顶。
   解法：行高固定 1.4，上下内边距按 (行高 88 - 文字行高) / 2 算。
   ============================================================ */

.ctext {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  max-height: 300rpx;
  /* 88 - 26*1.4(≈36) = 52，上下各 26 */
  padding: 26rpx 8rpx;
  margin: 0;
  font-size: 26rpx;
  line-height: 1.4;
  color: #11131a;
  background: transparent;
  box-sizing: content-box;
  vertical-align: middle;
}

/* 搜索框：和胶囊中线对齐 */
.findinput {
  height: 100%;
  min-height: 76rpx;
  padding: 0;
  margin: 0;
  line-height: 76rpx;
  font-size: 26rpx;
  vertical-align: middle;
}

/* ============================================================
   输入区垂直居中（第二轮修正）
   实际行高 = 胶囊 128rpx，文字块 36rpx，上下各留 46rpx 才对
   ============================================================ */

/* 输入态时胶囊高度改为内容驱动，多行时才变高 */
.capsule.composing-mode {
  height: auto;
  min-height: 128rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
}

.composing {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.holdbar.textrow {
  height: auto;
  min-height: 104rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8rpx;
}

.ctext {
  min-height: 0;
  max-height: 260rpx;
  padding: 20rpx 8rpx;
  margin: 0;
  font-size: 26rpx;
  line-height: 1.4;
  box-sizing: content-box;
}

/* ============================================================
   输入框最终版
   关键：app.json 里 defaultContentBox = true，所有元素默认 content-box。
   所以必须显式 border-box + width:0，否则 padding 会把宽度撑出容器。
   ============================================================ */

.ctext {
  flex: 1;
  min-width: 0;
  width: 0;                    /* flex 基准清零，靠 flex-grow 拿宽度 */
  box-sizing: border-box;      /* 抵消 defaultContentBox */
  min-height: 76rpx;
  max-height: 260rpx;
  padding: 20rpx 12rpx;
  margin: 0;
  font-size: 26rpx;
  line-height: 36rpx;          /* 显式行高，多行也是 36rpx 一行 */
  color: #11131a;
  background: transparent;
  text-align: left;
  vertical-align: middle;
}

.cph {
  color: #8a94a6;
  line-height: 36rpx;
}

.holdbar.textrow {
  height: auto;
  min-height: 116rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 6rpx;
  box-sizing: border-box;
}

/* 搜索框同样处理 */
.findbar {
  box-sizing: border-box;
}

.findinput {
  flex: 1;
  min-width: 0;
  width: 0;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  line-height: 76rpx;
  font-size: 26rpx;
  vertical-align: middle;
}

/* ============================================================
   输入区：加号重画 + 高度变化时的锚定规则

   设计依据（iMessage）：
   · 单行时，按钮和文字在同一条中线上
   · 多行时，按钮沉到底部（跟随最后一行），
     因为拇指在底部，按钮不该随着文字往上跑
   ============================================================ */

.holdbar.textrow {
  /* 关键：底部对齐。单行时靠内边距凑出视觉居中，多行时自然沉底 */
  align-items: flex-end;
  min-height: 116rpx;
  padding: 6rpx 6rpx 12rpx;
  box-sizing: border-box;
}

/* 文字框：上内边距略大于下内边距，让第一行和按钮中线对齐 */
.ctext {
  padding: 22rpx 12rpx 18rpx;
  line-height: 36rpx;
  min-height: 76rpx;
  max-height: 260rpx;
}

/* 加号：56rpx 圆形浅底 + 两条 3rpx 圆角杠，几何居中 */
.plusbtn {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  padding: 0;
  border-radius: 28rpx;
  background: rgba(120, 134, 155, 0.14);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plusbars {
  position: relative;
  width: 22rpx;
  height: 22rpx;
}

.pb-h {
  position: absolute;
  left: 0;
  top: 50%;
  width: 22rpx;
  height: 3rpx;
  margin-top: -1.5rpx;
  border-radius: 2rpx;
  background: #5b6473;
}

.pb-v {
  position: absolute;
  left: 50%;
  top: 0;
  width: 3rpx;
  height: 22rpx;
  margin-left: -1.5rpx;
  border-radius: 2rpx;
  background: #5b6473;
}

.plusbtn.rec {
  width: auto;
  min-width: 0;
  padding: 0 16rpx 0 12rpx;
  border-radius: 28rpx;
  background: rgba(255, 59, 48, 0.1);
  gap: 8rpx;
}

/* 右측按钮沉底后，和文字最后一行对齐 */
.send,
.micmode {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
}

.send {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
}

.send-img {
  width: 34rpx;
  height: 34rpx;
}

@media (prefers-color-scheme: dark) {
  .plusbtn {
    background: rgba(255, 255, 255, 0.1);
  }

  .pb-h,
  .pb-v {
    background: #c9d4e3;
  }
}

/* ============================================================
   输入区：最终裁定版（放在文件最末，覆盖前面所有零散规则）

   事实依据：
   1) app.json 里 defaultContentBox = true → 所有元素默认 content-box
   2) textarea 是原生组件，width:0 + flex:1 不会展开 → 必须外层 view 撑宽
   3) 前面有 7 条 .holdbar/.textrow/.ctext 的散装规则互相覆盖
   ============================================================ */

/* 外层撑宽：普通 view 可靠参与 flex */
.fieldwrap {
  flex: 1;
  min-width: 0;
  width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

/* 文字框：宽度吃满外层，高度由内容决定 */
.ctext {
  width: 100%;
  box-sizing: border-box;
  min-height: 40rpx;
  max-height: 240rpx;
  padding: 10rpx 0;
  margin: 0;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #11131a;
  background: transparent;
  border: none;
}

.cph {
  color: #8a94a6;
  font-size: 26rpx;
  line-height: 40rpx;
}

/* 一行：底部对齐，多行时按钮跟着最后一行 */
.holdbar.textrow {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 8rpx;
  width: 100%;
  height: auto;
  min-height: 64rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  box-shadow: none;
  border-radius: 0;
  box-sizing: border-box;
}

.plusbtn {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  padding: 0;
  border-radius: 28rpx;
  background: rgba(120, 134, 155, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.send,
.micmode {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
}

.send {
  background: linear-gradient(160deg, #2b96ff, #0060df);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx -12rpx rgba(0, 84, 214, 0.9);
}

.micmode {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 胶囊：输入态时按内容高度，留出上下呼吸 */
.capsule.composing-mode {
  height: auto;
  min-height: 112rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  align-items: center;
}

.composing {
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.composecol {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* ============================================================
   气泡元信息 + 引用块 + 引用条
   ============================================================ */

/* 元信息：气泡下方一行小字，右对齐（我的话）/左对齐（助手的话） */
.meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  padding: 0 6rpx;
  align-self: flex-end;
}

.meta.left {
  align-self: flex-start;
}

.meta-t {
  font-size: 19rpx;
  font-weight: 500;
  color: #a3adbb;
}

.meta-dot {
  font-size: 19rpx;
  color: #c3cbd6;
}

/* 同步状态：待上传是橙色，已上传是灰 */
.meta-s {
  font-size: 19rpx;
  font-weight: 600;
  color: #a3adbb;
}

.meta-s.wait {
  color: #e08a00;
}

/* 引用块：气泡里那一段灰底竖线 */
.qblock {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.16);
  border-left: 4rpx solid rgba(255, 255, 255, 0.6);
}

.bubble.agent .qblock {
  background: rgba(120, 134, 155, 0.1);
  border-left-color: rgba(120, 134, 155, 0.45);
}

.qblock-who {
  font-size: 19rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.78);
}

.bubble.agent .qblock-who {
  color: #8a94a6;
}

.qblock-t {
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bubble.agent .qblock-t {
  color: #5b6473;
}

/* 输入框上方的引用条 */
.quotebar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(120, 134, 155, 0.1);
}

.qb-line {
  flex: none;
  width: 4rpx;
  height: 34rpx;
  border-radius: 2rpx;
