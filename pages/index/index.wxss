  text-indent: 0.34em;
  color: #24304a;
  opacity: 0.26;
}

/* 覆盖旧规则里的透明度（否则 8.5% × 6% 几乎不可见） */
.wm { opacity: 1; height: auto; }

/* 水印上移，落在底部两条栏之上的空白 */
.wm { bottom: 300rpx; }
.wm-img { width: 190rpx; height: 156rpx; }

/* ============================================================
   宽度兜底：Skyline 里百分比/max-width 会被 min-content 顶掉
   所以全部改成显式 rpx（750rpx 恒等于屏幕宽）
   ============================================================ */

.content {
  width: 750rpx;
  overflow: hidden;
}

.tl,
.list {
  width: 750rpx;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.row {
  width: 694rpx;
  box-sizing: border-box;
}

.bubble {
  max-width: 520rpx;
  min-width: 0;
  flex: none;
}

.quote {
  width: 100%;
}

.photos {
  max-width: 694rpx;
}

/* ============================================================
   底部导航：胶囊四形态 + 滑动镜片（照原型复刻）
   ============================================================ */

.dock {
  display: flex;
  align-items: center;
}

.bottom.dragging .dock {
  transform: translateY(4rpx);
}

.capsule {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 124rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 62rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset 0 1rpx 0 #ffffff, 0 22rpx 48rpx -30rpx rgba(22, 38, 74, 0.55);
  overflow: hidden;
}

/* 导航形态：镜片 + 四个 tab */
.tabbar {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.lens {
  position: absolute;
  top: 12rpx;
  bottom: 12rpx;
  left: 0;
  border-radius: 50rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.62));
  box-shadow: inset 0 1rpx 0 #ffffff, 0 16rpx 36rpx -20rpx rgba(28, 44, 78, 0.55);
  pointer-events: none;
  z-index: 0;
}

.tab {
  z-index: 1;
  background: transparent;
  box-shadow: none;
}

/* 选中态的白底交给镜片，tab 本身不再画 */
.tab.on {
  background: transparent;
  box-shadow: none;
  color: #0060df;
}

/* 输入形态 */
.composing {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.hint {
  flex: 1;
  font-size: 26rpx;
  color: #8a94a6;
}

.composing .mic {
  flex: none;
}

/* 右钮图标 */
.fic {
  display: flex;
  align-items: center;
  justify-content: center;
}

.fic-t {
  font-size: 40rpx;
  color: #33405a;
  line-height: 1;
}

.fic-bubble {
  width: 34rpx;
  height: 30rpx;
  border: 3rpx solid #33405a;
  border-radius: 10rpx;
}

.fic-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #33405a;
}

.fic-down {
  width: 22rpx;
  height: 22rpx;
  border-right: 3rpx solid #33405a;
  border-bottom: 3rpx solid #33405a;
  transform: rotate(45deg) translate(-4rpx, -4rpx);
  margin-top: -8rpx;
}

/* ============================================================
   收起：genie（缩到右下角 + 模糊）
   ============================================================ */

.drawer.closing {
  animation: genieOut 0.2s cubic-bezier(0.55, 0.06, 0.68, 0.19) forwards;
  transform-origin: calc(100% - 60rpx) 100%;
}

@keyframes genieOut {
  0% {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }
  100% {
    opacity: 0;
    transform: translate(32rpx, 96rpx) scale(0.4, 0.08);
    filter: blur(8rpx);
  }
}

/* ============================================================
   录音态
   ============================================================ */

.rec {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  height: 100%;
  padding-right: 8rpx;
}

.rdot {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff3b30;
  margin-right: 14rpx;
  animation: recPulse 1.1s ease-in-out infinite;
}

@keyframes recPulse {
  0%,
  100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.45;
    transform: scale(0.82);
  }
}

.rtime {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  color: #d92c20;
  margin-right: 16rpx;
}

.rwave {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx;
}

.rbar {
  width: 6rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: #ff6a5e;
  animation: waveBar 0.72s ease-in-out infinite;
}

@keyframes waveBar {
  0%,
  100% {
    transform: scaleY(0.4);
  }
  50% {
    transform: scaleY(1.6);
  }
}

.rhint {
  flex: none;
  font-size: 22rpx;
  color: #8a94a6;
  margin-left: 16rpx;
}

/* 取消态：整条变红 */
.composing.cancel .rhint {
  color: #d92c20;
  font-weight: 600;
}

.composing.cancel .rbar,
.composing.cancel .rdot {
  background: #d92c20;
}

/* 波形再高一点，动起来更明显 */
.rwave { height: 56rpx; }
.rbar { height: 20rpx; width: 7rpx; }

/* 真图标：直接用原型 SVG 转出的 PNG */
.hicon {
  width: 42rpx;
  height: 42rpx;
}

.tic-img {
  width: 42rpx;
