}

.pin {
  position: absolute;
  top: 4rpx;
  left: 50%;
  margin-left: 10rpx;
  min-width: 26rpx;
  height: 26rpx;
  line-height: 26rpx;
  padding: 0 6rpx;
  border-radius: 13rpx;
  background: #ff3b30;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.fab {
  flex: none;
  width: 108rpx;
  height: 108rpx;
  margin-left: 18rpx;
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: inset 0 1rpx 0 #ffffff, 0 22rpx 48rpx -30rpx rgba(22, 38, 74, 0.55);
}

.fab-t {
  font-size: 40rpx;
  color: #33405a;
  line-height: 1;
}

/* 兜底：任何超宽内容都不许撑开滚动区 */
.row {
  overflow: hidden;
}

.quote {
  max-width: 100%;
}

.bubble {
  overflow: hidden;
}

.photos {
  overflow: hidden;
}

/* ============================================================
   交互层：转场 / 抽屉 / 搜索形态
   ============================================================ */

/* 内容区：转场只动内容，不动头部和底部 */
.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.in-left {
  animation: inLeft 0.26s cubic-bezier(0.32, 0.72, 0.24, 1);
}
.in-right {
  animation: inRight 0.26s cubic-bezier(0.32, 0.72, 0.24, 1);
}

@keyframes inLeft {
  from {
    opacity: 0;
    transform: translateX(26px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes inRight {
  from {
    opacity: 0;
    transform: translateX(-26px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* 上拉抽屉：外层裁切，内层保持原尺寸（不压扁文字） */
.drawer {
  overflow: hidden;
  border-radius: 32rpx;
  margin-bottom: 0;
  transition: height 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.drawer.dragging {
  transition: none;
}

.drawer-inner {
  display: flex;
  flex-direction: column;
  padding: 22rpx 24rpx 26rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 255, 255, 0.96);
  box-shadow: 0 20rpx 44rpx -30rpx rgba(22, 38, 74, 0.5), inset 0 1rpx 0 #ffffff;
}

.dp-label {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1.2rpx;
  color: #8a94a6;
