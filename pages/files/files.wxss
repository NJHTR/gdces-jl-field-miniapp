page {
  height: 100%;
  background: #f4f6f9;
}

.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f4f6f9;
}

.fhdr {
  flex: none;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  gap: 18rpx;
  padding: 0 28rpx 18rpx;
  background: #f4f6f9;
}

.back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.back-img {
  width: 32rpx;
  height: 32rpx;
}

.htitle {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.h1 {
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 700;
  color: #11131a;
  letter-spacing: -0.5rpx;
}

.h2 {
  font-size: 22rpx;
  color: #8a94a6;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.segments {
  flex: none;
  display: flex;
  flex-direction: row;
  margin: 0 28rpx 8rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: #e8edf4;
}

.segment {
  flex: 1;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 15rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #667085;
  transition: background 160ms ease, color 160ms ease;
}

.segment.on {
  background: #ffffff;
  color: #11131a;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(30, 42, 60, 0.08);
}

.fbody {
  flex: 1;
  min-height: 0;
  padding: 0 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.sec {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
  padding: 26rpx 6rpx 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #8a94a6;
}

.sec-n {
  font-size: 20rpx;
  font-weight: 400;
  color: #a7b0bf;
}

.group {
  background: #ffffff;
  border-radius: 26rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx -26rpx rgba(22, 38, 74, 0.45);
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 18rpx 22rpx;
  border-top: 1rpx solid rgba(120, 134, 155, 0.12);
}

.row:first-child {
  border-top: none;
}

.row:active {
  background: #f7f9fc;
}

.row-ic {
  flex: none;
  width: 66rpx;
  height: 66rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.row-ic.doc {
  background: #eaf3ff;
}

.row-ic.file {
  background: #f0edff;
}

.row-ic image {
  width: 34rpx;
  height: 34rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.row-t {
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 550;
  color: #11131a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-s {
  font-size: 21rpx;
  color: #8a94a6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pill {
  flex: none;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 19rpx;
  line-height: 1.4;
}

.pill.ok {
  background: #e7f8ed;
  color: #0f8a3c;
}

.pill.wait {
  background: #eaf3ff;
  color: #0a6dff;
}

.pill.todo {
  background: #fff4e6;
  color: #a35b00;
}

.chev {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  opacity: 0.55;
}

.open {
  flex: none;
  font-size: 22rpx;
  font-weight: 600;
  color: #0a6dff;
}

.pgrid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.pcell {
  position: relative;
  flex: none;
  border-radius: 16rpx;
  overflow: hidden;
  background: #dfe5ee;
}

.pimg {
  width: 100%;
  height: 100%;
  display: block;
}

.pveil {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 80rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.34));
}

.pdate {
  position: absolute;
  left: 12rpx;
  bottom: 10rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.94);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 110rpx 40rpx 0;
}

.empty-t {
  font-size: 28rpx;
  font-weight: 550;
  color: #5b6473;
}

.empty-s {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9aa4b3;
  text-align: center;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  gap: 18rpx;
}

.spinner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  border: 3rpx solid #dce4ef;
  border-top-color: #0a6dff;
  animation: spin 800ms linear infinite;
}

.loading-t {
  font-size: 22rpx;
  color: #8a94a6;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx;
  gap: 22rpx;
}

.error-t {
  font-size: 25rpx;
  color: #8a94a6;
}

.retry {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  color: #0a6dff;
}

.orow {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
  padding: 22rpx;
  border-top: 1rpx solid rgba(120, 134, 155, 0.12);
}

.orow:first-child {
  border-top: none;
}

.ok {
  flex: 0 0 188rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8a94a6;
}

.ov {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #11131a;
  word-break: break-all;
}

.ghostbtn {
  margin-top: 18rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #0a6dff;
}

.tb-pad {
  height: 50rpx;
}

.pg-pad {
  height: 30rpx;
}

@media (prefers-color-scheme: dark) {
  page,
  .page,
  .fhdr {
    background: #0f141b;
  }

  .h1,
  .row-t,
  .ov {
    color: #eaf1fb;
  }

  .h2,
  .sec,
  .row-s,
  .empty-t,
  .empty-s,
  .ok,
  .loading-t,
  .error-t {
    color: #8f9bad;
  }

  .back,
  .group,
  .ghostbtn,
  .retry {
    background: #1c2430;
  }

  .segments {
    background: #1a222d;
  }

  .segment {
    color: #9aa8ba;
  }

  .segment.on {
    background: #2a3544;
    color: #ffffff;
  }

  .row {
    border-top-color: rgba(255, 255, 255, 0.08);
  }

  .row:active {
    background: #232d3a;
  }

  .row-ic.doc {
    background: rgba(10, 109, 255, 0.14);
  }

  .row-ic.file {
    background: rgba(120, 100, 255, 0.14);
  }

  .pill.wait {
    background: rgba(10, 109, 255, 0.16);
    color: #79b4ff;
  }

  .pill.ok {
    background: rgba(20, 160, 80, 0.16);
    color: #6ee7a0;
  }

  .pill.todo {
    background: rgba(190, 120, 20, 0.16);
    color: #f3c26b;
  }

  .orow {
    border-top-color: rgba(255, 255, 255, 0.08);
  }
}
