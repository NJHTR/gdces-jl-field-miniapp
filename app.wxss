/**app.wxss**/
page {
  height: 100%;
  color: #11131a;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", sans-serif;
}

/* Skyline 下 page 的字体不一定往下继承，这里显式铺一遍 */
view,
text,
button,
input,
textarea,
scroll-view {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", sans-serif;
}

view,
text,
image,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: none;
  line-height: normal;
}

button::after {
  border: none;
}
