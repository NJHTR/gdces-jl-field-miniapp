<!-- 最终态 trace：L1 轮次 / L2 阶段-步骤 / L3 单步详情；不做第 4 层 -->
<view class="tr" wx:if="{{ready}}">
  <!-- L1：默认收起，运行中固定展示当前步 -->
  <view
    class="tr-head tr-head-{{run.tone}}"
    bindtap="onToggleRun"
    aria-role="button"
    aria-expanded="{{openRun}}"
    aria-label="{{run.title}}，{{run.metaText}}，{{openRun ? '收起' : '展开'}}执行过程"
  >
    <view class="tr-dot tr-dot-{{run.tone}}"></view>
    <view class="tr-h-main">
      <view class="tr-h-line">
        <text class="tr-h-title">{{run.title}}</text>
        <text class="tr-h-meta" wx:if="{{run.metaText}}">{{run.metaText}}</text>
      </view>
      <text class="tr-h-sum" wx:if="{{run.summary && run.running}}">{{run.summary}}</text>
      <text class="tr-h-cur" wx:if="{{!openRun && run.currentStep}}">正在：{{run.currentStep}}</text>
    </view>
    <view class="tr-chev {{openRun ? 'up' : ''}}"></view>
  </view>

  <!-- L2：阶段分组 + 步骤行；L3 用 wx:if 挂载，收起即卸载 -->
  <view class="tr-body" wx:if="{{openRun}}">
    <text class="tr-more" wx:if="{{moreCount}}">更早 {{moreCount}} 步已折叠</text>

    <view class="tr-fail-group" wx:if="{{failures.length}}">
      <view
        class="tr-fail"
        wx:for="{{failures}}"
        wx:key="stepId"
        data-step="{{item.stepId}}"
        bindtap="onToggleStep"
        aria-role="button"
        aria-expanded="{{item.open}}"
        aria-label="{{item.aria}}"
      >
        <view class="tr-step-line">
          <view class="tr-ic tr-ic-fail"><text>!</text></view>
          <view class="tr-step-main">
            <text class="tr-step-name">{{item.name}}</text>
            <view class="tr-step-meta">
              <text class="tr-meta">失败 · {{item.phaseLabel}}</text>
              <text class="tr-meta" wx:if="{{item.retryText}}">· {{item.retryText}}</text>
              <text class="tr-meta" wx:if="{{item.durText}}">· {{item.durText}}</text>
            </view>
          </view>
          <text class="tr-caret">{{item.open ? '⌃' : '⌄'}}</text>
        </view>
        <view class="tr-l3" wx:if="{{item.open}}">
          <view class="tr-l3-block" wx:if="{{item.inputText}}">
            <text class="tr-l3-k">输入</text>
            <text class="tr-l3-pre" selectable>{{item.inputText}}</text>
          </view>
          <view class="tr-l3-block" wx:if="{{item.summary}}">
            <text class="tr-l3-k">摘要</text>
            <text class="tr-l3-pre" selectable>{{item.summary}}</text>
          </view>
          <view class="tr-l3-block" wx:if="{{item.outputText}}">
            <text class="tr-l3-k">输出</text>
            <text class="tr-l3-pre" selectable>{{item.outputText}}</text>
          </view>
          <text class="tr-trunc" wx:if="{{item.truncated}}" data-seq="{{item.seq}}" catchtap="onLoadDetail">已截断 · {{item.sizeText || '较大'}} · 查看完整</text>
          <view class="tr-l3-block" wx:if="{{item.errorText}}">
            <text class="tr-l3-k tr-l3-k-err">错误</text>
            <text class="tr-l3-pre tr-l3-pre-err" selectable>{{item.errorText}}</text>
          </view>
          <view class="tr-arts" wx:if="{{item.artifacts.length}}">
            <block wx:for="{{item.artifacts}}" wx:for-item="a" wx:key="name">
              <image
                wx:if="{{a.url}}"
                class="tr-art-img"
                src="{{a.url}}"
                mode="aspectFill"
                lazy-load
                data-url="{{a.url}}"
                bindtap="onArtifact"
              />
              <view wx:else class="tr-art-chip" data-url="{{a.url}}" data-docid="{{a.docId}}" bindtap="onArtifact">{{a.name || '产物'}}</view>
            </block>
          </view>
        </view>
      </view>
      <text class="tr-fail-more" wx:if="{{failureMore}}">另有 {{failureMore}} 个失败步骤</text>
    </view>

    <view class="tr-phase" wx:for="{{phases}}" wx:for-item="ph" wx:key="key">
      <view class="tr-ph-h">
        <text class="tr-ph-t">{{ph.label}}</text>
      </view>

      <view
        class="tr-step"
        wx:for="{{ph.steps}}"
        wx:for-item="st"
        wx:key="stepId"
        data-step="{{st.stepId}}"
        bindtap="onToggleStep"
        aria-role="button"
        aria-expanded="{{st.open}}"
        aria-label="{{st.aria}}"
      >
        <view class="tr-step-line">
          <view class="tr-ic tr-ic-{{st.statusTone}}"><text>{{st.statusGlyph}}</text></view>
          <view class="tr-step-main">
            <text class="tr-step-name">{{st.name}}</text>
            <view class="tr-step-meta">
              <text class="tr-meta tr-meta-{{st.statusTone}}">{{st.statusLabel}}</text>
              <text class="tr-meta" wx:if="{{st.durText}}">· {{st.durText}}</text>
              <text class="tr-meta tr-meta-retry" wx:if="{{st.retryText}}">· {{st.retryText}}</text>
              <text class="tr-meta tr-meta-fail" wx:if="{{st.hadFailure}}">· 曾失败</text>
            </view>
          </view>
          <text class="tr-caret">{{st.open ? '⌃' : '⌄'}}</text>
        </view>

        <view class="tr-l3" wx:if="{{st.open}}">
          <view class="tr-l3-block" wx:if="{{st.inputText}}">
            <text class="tr-l3-k">输入</text>
            <text class="tr-l3-pre" selectable>{{st.inputText}}</text>
          </view>
          <view class="tr-l3-block" wx:if="{{st.summary}}">
            <text class="tr-l3-k">摘要</text>
            <text class="tr-l3-pre" selectable>{{st.summary}}</text>
          </view>
          <view class="tr-l3-block" wx:if="{{st.outputText}}">
            <text class="tr-l3-k">输出</text>
            <text class="tr-l3-pre" selectable>{{st.outputText}}</text>
          </view>
          <text class="tr-trunc" wx:if="{{st.truncated}}" data-seq="{{st.seq}}" catchtap="onLoadDetail">已截断 · {{st.sizeText || '较大'}} · 查看完整</text>
          <view class="tr-l3-block" wx:if="{{st.errorText}}">
            <text class="tr-l3-k tr-l3-k-err">错误</text>
            <text class="tr-l3-pre tr-l3-pre-err" selectable>{{st.errorText}}</text>
          </view>
          <view class="tr-l3-block" wx:if="{{st.hadFailure && st.failureText}}">
            <text class="tr-l3-k tr-l3-k-err">上次失败</text>
            <text class="tr-l3-pre tr-l3-pre-err" selectable>{{st.failureText}}</text>
          </view>
          <view class="tr-arts" wx:if="{{st.artifacts.length}}">
            <block wx:for="{{st.artifacts}}" wx:for-item="a" wx:key="name">
              <image
                wx:if="{{a.url}}"
                class="tr-art-img"
                src="{{a.url}}"
                mode="aspectFill"
                lazy-load
                data-url="{{a.url}}"
                bindtap="onArtifact"
              />
              <view wx:else class="tr-art-chip" data-url="{{a.url}}" data-docid="{{a.docId}}" bindtap="onArtifact">{{a.name || '产物'}}</view>
            </block>
          </view>
          <text class="tr-empty-detail" wx:if="{{!st.inputText && !st.outputText && !st.errorText && !st.artifacts.length}}">这一步没有更多细节</text>
        </view>
      </view>
    </view>

    <view class="tr-empty" wx:if="{{!phases.length && !failures.length}}">还没有步骤</view>
  </view>

  <!-- 完整输出弹层：详情接口懒加载，不把大文本放进 data -->
  <view class="tr-mask" wx:if="{{detailOpen}}" catchtap="onCloseDetail" catchtouchmove="noop">
    <view class="tr-modal" catchtap="onModalTap">
      <view class="tr-modal-h">
        <text class="tr-modal-t">{{detailTitle}}</text>
        <text class="tr-modal-x" bindtap="onCloseDetail" aria-role="button">关闭</text>
      </view>
      <scroll-view class="tr-modal-scroll" scroll-y>
        <text class="tr-modal-body" selectable>{{detailText}}</text>
        <text class="tr-modal-loading" wx:if="{{detailLoading}}">加载中…</text>
      </scroll-view>
      <view class="tr-modal-f">
        <text class="tr-modal-copy" bindtap="onCopyDetail" aria-role="button">复制</text>
        <text class="tr-modal-tip">已脱敏 · 仅本步</text>
      </view>
    </view>
  </view>
</view>
<view class="tr-wait" wx:else>执行中…</view>
