/* 最终态 trace：像正文旁边的一行轻量记录，不做独立卡片 */
.tr {
  width: 100%;
  margin-top: 4rpx;
  margin-bottom: 2rpx;
  box-sizing: border-box;
}

/* ---------- L1 轮次行：只留一行灰字，不抢正文 ---------- */
.tr-head {
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 2rpx 6rpx;
  border-radius: 0;
  background: transparent;
  border: 0;
}

.tr-dot {
  flex: none;
  width: 8rpx;
  height: 8rpx;
  margin: 0 10rpx 0 0;
  border-radius: 50%;
  background: #c5cbd3;
}

.tr-dot-run {
  background: #5b8def;
}

.tr-dot-retry {
  background: #c08a45;
}

.tr-dot-fail {
  background: #d96b62;
}

.tr-dot-idle {
  background: #cbd1d8;
}

.tr-dot-done {
  background: #b8c0ca;
}

.tr-dot-skip {
  background: #cbd1d8;
}

.tr-h-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.tr-h-line {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex-wrap: wrap;
}

.tr-h-title {
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 400;
  color: #8b95a4;
}

.tr-h-meta {
  margin-left: 8rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #9aa4b5;
}

.tr-h-sum {
  margin-top: 1rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #a6aeb9;
}

.tr-h-cur {
  margin-top: 1rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #6c7c91;
}

.tr-chev {
  flex: none;
  width: 13rpx;
  height: 13rpx;
  margin: 3rpx 0 0 10rpx;
  border-right: 2rpx solid #c0c7d0;
  border-bottom: 2rpx solid #c0c7d0;
  transform: rotate(45deg);
  transition: transform 180ms cubic-bezier(0.2, 0, 0, 1);
}

.tr-chev.up {
  transform: rotate(-135deg);
}

/* ---------- L2 阶段/步骤：细时间线，无卡片 ---------- */
.tr-body {
  margin-top: 0;
  padding: 0 0 0 2rpx;
}

.tr-more {
  display: block;
  margin: 4rpx 4rpx 2rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: #aab2bd;
}

.tr-ph-h {
  display: none;
}

.tr-step,
.tr-fail {
  min-height: 60rpx;
  box-sizing: border-box;
  padding: 8rpx 4rpx;
  border-radius: 0;
}

.tr-step:active,
.tr-fail:active {
  background: rgba(120, 134, 155, 0.05);
}

.tr-step-line {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.tr-ic {
  flex: none;
  width: 22rpx;
  height: 22rpx;
  margin: 4rpx 10rpx 0 0;
  border-radius: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 400;
  line-height: 1;
  background: transparent;
}

.tr-ic-done {
  background: transparent;
  color: #a4adb9;
}

.tr-ic-run {
  background: transparent;
  color: #5b8def;
}

.tr-ic-retry {
  background: transparent;
  color: #b98645;
}

.tr-ic-fail {
  background: transparent;
  color: #cf6b62;
}

.tr-ic-idle,
.tr-ic-skip {
  background: transparent;
  color: #b9c1cb;
}

.tr-step-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: baseline;
}

.tr-step-phase {
  flex: none;
  font-size: 19rpx;
  line-height: 1.4;
  color: #a7afba;
}

.tr-step-sep {
  flex: none;
  margin: 0 4rpx;
  font-size: 19rpx;
  line-height: 1.4;
  color: #c0c7d0;
}

.tr-step-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 23rpx;
  line-height: 1.4;
  color: #46505f;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tr-step-meta {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  flex: none;
  margin-top: 0;
  margin-left: 8rpx;
}

.tr-meta {
  font-size: 19rpx;
  line-height: 1.4;
  color: #a2abb7;
  margin-right: 2rpx;
  white-space: nowrap;
}

.tr-meta-run {
  color: #5b8def;
}

.tr-meta-fail {
  color: #c66a62;
}

.tr-meta-retry {
  color: #b98645;
}

.tr-caret {
  flex: none;
  width: 22rpx;
  text-align: right;
  font-size: 18rpx;
  color: #c3c9d2;
}

/* 失败也只是一行，不再单独做一块红色卡片 */
.tr-fail-group {
  margin: 2rpx 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  border: 0;
}

.tr-fail {
  background: transparent;
}

.tr-fail .tr-step-line {
  padding-left: 8rpx;
  border-left: 2rpx solid rgba(207, 107, 98, 0.28);
}

.tr-fail .tr-step-name {
  color: #b05a53;
}

.tr-fail-more {
  display: block;
  margin: 2rpx 8rpx 4rpx;
  font-size: 19rpx;
  color: #b05a53;
}

/* ---------- L3 单步详情：正文式缩进，不套灰盒 ---------- */
.tr-l3 {
  width: calc(100% - 32rpx);
  max-width: calc(100% - 32rpx);
  box-sizing: border-box;
  margin: 2rpx 0 6rpx 32rpx;
  padding: 2rpx 14rpx 4rpx 14rpx;
  border-radius: 0;
  background: transparent;
  border: 0;
  border-left: 1rpx solid rgba(120, 134, 155, 0.18);
  overflow: hidden;
}

.tr-l3-block {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  margin-bottom: 6rpx;
}

.tr-l3-k {
  font-size: 18rpx;
  line-height: 1.5;
  color: #a5adb8;
  letter-spacing: 1rpx;
}

.tr-l3-k-err {
  color: #c66a62;
}

.tr-l3-pre {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  margin-top: 1rpx;
  font-size: 21rpx;
  line-height: 1.55;
  color: #5c6776;
  word-break: break-all;
  overflow-wrap: break-word;
  white-space: pre-line;
  overflow: hidden;
}

.tr-l3-line {
  display: block;
  width: 100%;
  font-size: 21rpx;
  line-height: 1.55;
  color: #5c6776;
  word-break: break-all;
  white-space: pre-wrap;
}

.tr-l3-pre-err .tr-l3-line {
  color: #ad5a53;
}

.tr-l3-pre-err {
  color: #ad5a53;
}

.tr-trunc {
  display: block;
  margin-top: 1rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #6f8db3;
}

.tr-arts {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 6rpx;
}

.tr-art-img {
  width: 88rpx;
  height: 88rpx;
  margin: 0 8rpx 6rpx 0;
  border-radius: 8rpx;
  background: rgba(120, 134, 155, 0.08);
}

.tr-art-chip {
  margin: 0 8rpx 6rpx 0;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #6f8db3;
  background: rgba(120, 134, 155, 0.07);
}

.tr-empty-detail,
.tr-empty {
  display: block;
  padding: 10rpx 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #a5adb8;
}

.tr-wait {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #a5adb8;
}

/* ---------- 完整输出弹层 ---------- */
.tr-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  background: rgba(17, 24, 39, 0.42);
  display: flex;
  align-items: flex-end;
}

.tr-modal {
  width: 100%;
  max-height: 72vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  display: flex;
  flex-direction: column;
}

.tr-modal-h {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
}

.tr-modal-t {
  font-size: 27rpx;
  font-weight: 600;
  color: #11131a;
}

.tr-modal-x {
  font-size: 24rpx;
  color: #0a6dff;
  padding: 8rpx 10rpx;
}

.tr-modal-scroll {
  flex: 1;
  min-height: 0;
  max-height: 52vh;
}

.tr-modal-body {
  font-size: 23rpx;
  line-height: 1.6;
  color: #33405a;
  white-space: pre-wrap;
  word-break: break-all;
}

.tr-modal-loading {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.tr-modal-f {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(17, 24, 39, 0.08);
}

.tr-modal-copy {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 30rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0a6dff;
  background: rgba(10, 109, 255, 0.08);
}

.tr-modal-tip {
  font-size: 20rpx;
  color: #9aa4b5;
}

/* ---------- 深色模式：只换字色，不加回卡片 ---------- */
@media (prefers-color-scheme: dark) {
  .tr-head {
    background: transparent;
    border: 0;
  }

  .tr-h-title {
    color: #aeb8c6;
  }

  .tr-h-meta,
  .tr-h-sum,
  .tr-h-cur,
  .tr-step-phase,
  .tr-meta {
    color: #8f9aa9;
  }

  .tr-step-sep {
    color: #6f7a8a;
  }

  .tr-step-name,
  .tr-modal-t {
    color: #d3dce8;
  }

  .tr-modal-body {
    color: #c9d4e3;
  }

  .tr-fail .tr-step-name,
  .tr-l3-pre-err {
    color: #ff9c93;
  }

  .tr-l3 {
    background: transparent;
    border-left-color: rgba(255, 255, 255, 0.13);
  }

  .tr-l3-pre {
    color: #c9d4e3;
  }

  .tr-l3-line {
    color: #c9d4e3;
  }

  .tr-l3-pre-err .tr-l3-line {
    color: #ff9c93;
  }

  .tr-ic-done,
  .tr-ic-idle,
  .tr-ic-skip {
    background: transparent;
    color: #8f9aa9;
  }

  .tr-fail-group {
    background: transparent;
    border: 0;
  }

  .tr-fail .tr-step-line {
    border-left-color: rgba(255, 156, 147, 0.28);
  }

  .tr-modal {
    background: #1b2330;
  }

  .tr-modal-f {
    border-top-color: rgba(255, 255, 255, 0.1);
  }

  .tr-art-img {
    background: rgba(255, 255, 255, 0.08);
  }
}
